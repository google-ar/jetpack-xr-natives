module(
    name = "com_google_jxr_natives",
)

# Bazel modules
bazel_dep(name = "rules_android_ndk", version = "0.1.2")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_android", version = "0.6.0", repo_name = "build_bazel_rules_android")
bazel_dep(name = "abseil-cpp", version = "20240722.0")
bazel_dep(name = "bazel_skylib", version = "1.2.1")
bazel_dep(name = "jsoncpp", version = "1.9.5")
bazel_dep(name = "third_party")
local_path_override(
    module_name = "third_party",
    path = "../third_party",
)

bazel_dep(name = "com_google_impress")
local_path_override(
    module_name = "com_google_impress",
    path = "../impress",
)

# Set up the Android NDK
android_ndk_repository_extension = use_extension("@rules_android_ndk//:extension.bzl", "android_ndk_repository_extension")
android_ndk_repository_extension.configure(api_level = 29)
use_repo(android_ndk_repository_extension, "androidndk")

register_toolchains("@androidndk//:all")
