include "split_engine/schemas/split_engine_attributes.fbs";
include "split_engine/schemas/split_engine_primitive.fbs";

namespace android_xr.schemas;

table BoundsInfo (requires_api: 1) {
  bounds : Box (required, id: 0, requires_api: 1);
}

// LINT.IfChange
enum VertexAttribute : uint8 (requires_api: 1) {
  POSITION = 0 (requires_api: 1),
  TANGENTS = 1 (requires_api: 1),
  COLOR = 2 (requires_api: 1),
  UV0 = 3 (requires_api: 1),
  UV1 = 4 (requires_api: 1),
  BONE_INDICES = 5 (requires_api: 1),
  BONE_WEIGHTS = 6 (requires_api: 1),
  MORPH_POSITION_0 = 8 (requires_api: 1),
  MORPH_POSITION_1 = 9 (requires_api: 1),
  MORPH_POSITION_2 = 10 (requires_api: 1),
  MORPH_POSITION_3 = 11 (requires_api: 1),
  MORPH_TANGENTS_0 = 12 (requires_api: 1),
  MORPH_TANGENTS_1 = 13 (requires_api: 1),
  MORPH_TANGENTS_2 = 14 (requires_api: 1),
  MORPH_TANGENTS_3 = 15 (requires_api: 1),
}

enum AttributeType : uint8 (requires_api: 1) {
  BYTE = 0 (requires_api: 1),
  BYTE2 = 1 (requires_api: 1),
  BYTE3 = 2 (requires_api: 1),
  BYTE4 = 3 (requires_api: 1),
  UBYTE = 4 (requires_api: 1),
  UBYTE2 = 5 (requires_api: 1),
  UBYTE3 = 6 (requires_api: 1),
  UBYTE4 = 7 (requires_api: 1),
  SHORT = 8 (requires_api: 1),
  SHORT2 = 9 (requires_api: 1),
  SHORT3 = 10 (requires_api: 1),
  SHORT4 = 11 (requires_api: 1),
  USHORT = 12 (requires_api: 1),
  USHORT2 = 13 (requires_api: 1),
  USHORT3 = 14 (requires_api: 1),
  USHORT4 = 15 (requires_api: 1),
  INT = 16 (requires_api: 1),
  UINT = 17 (requires_api: 1),
  FLOAT = 18 (requires_api: 1),
  FLOAT2 = 19 (requires_api: 1),
  FLOAT3 = 20 (requires_api: 1),
  FLOAT4 = 21 (requires_api: 1),
  HALF = 22 (requires_api: 1),
  HALF2 = 23 (requires_api: 1),
  HALF3 = 24 (requires_api: 1),
  HALF4 = 25 (requires_api: 1),
}

struct VertexAttributeInfo (requires_api: 1) {
  attribute: VertexAttribute (id: 0, requires_api: 1);
  type: AttributeType (id: 1, requires_api: 1);
  offset: uint32 (id: 2, requires_api: 1);
  normalized: bool (id: 3, requires_api: 1);
}

table VertexBlockInfo (requires_api: 1) {
  // TODO: If attributes were separated out, we could build
  // in-place in mesh_builder.cc.
  attributes: [VertexAttributeInfo] (required, id: 0, requires_api: 1);
  buffer: [uint8] (required, id: 1, requires_api: 1);
  stride: uint32 (id: 2, requires_api: 1);
}

table VertexBufferInfo (requires_api: 1) {
  blocks: [VertexBlockInfo] (required, id: 0, requires_api: 1);
  vertex_count: ulong (id: 1, requires_api: 1);
  advanced_skinning: bool (id: 2, requires_api: 1);
}

enum IndexType : uint8 (requires_api: 1) {
  USHORT = 0 (requires_api: 1),
  UINT = 1 (requires_api: 1),
}

table IndexBufferInfo (requires_api: 1) {
  type: IndexType (id: 0, requires_api: 1);
  buffer: [uint8] (required, id: 1, requires_api: 1);
}
// LINT.ThenChange(//depot/google3/third_party/impress/core/split_engine/flatbuffer_size_calculator.cc)

// LINT.IfChange
table MorphTargetAttributeInfo (requires_api: 1) {
  positions : [uint8] (required, id: 0, requires_api: 1);
  tangents: [uint8] (required, id: 1, requires_api: 1);
}

table MorphTargetBufferInfo (requires_api: 1) {
  targets : [MorphTargetAttributeInfo] (required, id: 0, requires_api: 1);
  vertex_count : ulong (id: 1, requires_api: 1);
}

enum VertexAccessFlags : ubyte (bit_flags, requires_api: 1) {
  kPosition = 0 (requires_api: 1),  // (1 << 0)
  kTangent = 1 (requires_api: 1),   // (1 << 1)
}

table VertexBuffer (requires_api: 1) {
  id: uint64 (id: 0, requires_api: 1);
  buffer: VertexBufferInfo (id: 1, requires_api: 1);
  vertex_access_flags: VertexAccessFlags (id: 2, requires_api: 1);
}

table IndexBuffer (requires_api: 1) {
  id: uint64 (id: 0, requires_api: 1);
  buffer: IndexBufferInfo (id: 1, requires_api: 1);
  store_index_data: bool (id: 2, requires_api: 1);
}

table MorphTargetBuffer (requires_api: 1) {
  id: uint64 (id: 0, requires_api: 1);
  buffer: MorphTargetBufferInfo (id: 1, requires_api: 1);
}

table ImageParams (requires_api: 1) {
  level: uint8 (id: 0, requires_api: 1);
  format: uint8 (id: 1, requires_api: 1);
  type: uint8 (id: 2, requires_api: 1);
  alignment: uint8 (id: 3, requires_api: 1);
  left: uint32 (id: 4, requires_api: 1);
  top: uint32 (id: 5, requires_api: 1);
  stride: uint32 (id: 6, requires_api: 1);
}

table PixelBuffer (requires_api: 1) {
  buffer: [ubyte] (id: 0, requires_api: 1);
}

table Texture (requires_api: 1) {
  id: uint64 (id: 0, requires_api: 1);
  width: uint32 (id: 1, requires_api: 1);
  height: uint32 (id: 2, requires_api: 1);
  format: uint16 (id: 3, requires_api: 1);
  levels: uint8 (id: 4, requires_api: 1);
  sampler: uint8 (id: 5, requires_api: 1);
  mips: bool (id: 6, requires_api: 1);
  image_params: [ImageParams] (required, id: 7, requires_api: 1);
  pixel_buffers: [PixelBuffer] (required, id: 8, requires_api: 1);
}
// LINT.ThenChange(//depot/google3/third_party/impress/core/split_engine/flatbuffer_size_calculator.cc)

table LayerMask (requires_api: 1) {
  select: uint8 (id: 0, requires_api: 1);
  values: uint8 (id: 1, requires_api: 1);
}

table Bones (requires_api: 1) {
  bones: [Mat4f] (id: 0, requires_api: 1);
}

table MorphWeights (requires_api: 1) {
  weights: [float] (id: 0, requires_api: 1);
  offset: uint32 (id: 1, requires_api: 1);
}

union TransformData (requires_api: 1) {
  Mat4f = 1 (requires_api: 1),
  Mat4 = 2 (requires_api: 1),
}

table Transform (requires_api: 1) {
  data: TransformData (id: 1, requires_api: 1);
}

table Parent (requires_api: 1) {
  entity: uint32 (id: 0, requires_api: 1);
}

table BoxCollider (requires_api: 1) {
  center: Float3 (id: 0, requires_api: 1);
  half_extent: Float3 (id: 1, requires_api: 1);
}

table SphereCollider (requires_api: 1) {
  center: Float3 (id: 0, requires_api: 1);
  radius: Float (id: 1, requires_api: 1);
}

table CapsuleCollider (requires_api: 1) {
  center: Float3 (id: 0, requires_api: 1);
  height: Float (id: 1, requires_api: 1);
  radius: Float (id: 2, requires_api: 1);
}

// A per-triangle mesh collider. In order for this to be used, the corresponding
// VertexBuffers and IndexBuffers must specify that mesh data should be
// retained. This can be done by configuring vertex_access_flags and
// store_index_data fields, respectively.
table MeshCollider (requires_api: 1) {
  // Empty
}

// Type of collider, primarily used for removal operations.
enum ColliderType : uint8 (requires_api: 1) {
  BoxCollider = 0 (requires_api: 1),
  MeshCollider = 1 (requires_api: 1),
  SphereCollider = 2 (requires_api: 1),
  CapsuleCollider = 3 (requires_api: 1),
}

// Collider data that includees optional parameters for creation.
union ColliderData (requires_api: 1) {
  BoxCollider = 1 (requires_api: 1),
  MeshCollider = 2 (requires_api: 1),
  SphereCollider = 3 (requires_api: 1),
  CapsuleCollider = 4 (requires_api: 1),
}

table AddOrUpdateCollider (requires_api: 1) {
  // Adds or updates the collider from the node associated with this client
  // entity id. Does nothing if the node is not found.
  entity: uint32 (id: 0, requires_api: 1);
  // Adds the collider when the same type of collider doesn't exist; Updates
  // the collider when the same type of collider already exists.
  collider_data: ColliderData (id: 2, requires_api: 1);
  // Updates the enabled state of the collider if set.
  // Otherwise the enabled state is left unchanged.
  enabled: Bool (id: 3, requires_api: 1);
}

table RemoveCollider (requires_api: 1) {
  // Removes the collider from the node associated with this client entity id.
  // Does nothing if the node is not found.
  entity: uint32 (id: 0, requires_api: 1);
  // Removes the type of the collider if exists.
  collider_type: ColliderType (id: 1, requires_api: 1);
}

table AddNode (requires_api: 1) {
  // Adds a node associated with this client entity id.
  entity: uint32 (id: 0, requires_api: 1);
}

table UpdateNode (requires_api: 1) {
  // Updates the node associated with this client entity id.
  // Does nothing if the node is not found.
  entity: uint32 (id: 0, requires_api: 1);

  // Updates the name of the node if set.
  // Otherwise the name is left unchanged.
  //
  // Used for debugging purposes only.
  name: string (id: 1, requires_api: 1);

  // Updates the enabled state of the node if set.
  // Otherwise the enabled state is left unchanged.
  enabled: Bool (id: 2, requires_api: 1);

  // Updates the transform of the node if set.
  // Otherwise the transform is left unchanged.
  transform: Transform (id: 3, requires_api: 1);

  // Updates the parent of the node if set.
  // Otherwise the parent is left unchanged.
  parent: Parent (id: 4, requires_api: 1);
}

// LINT.IfChange
// For a given cubemap level, the offset in bytes of each face.
table FaceOffsets (requires_api: 1) {
  px: uint (id: 0, requires_api: 1); // +x face offset in bytes
  nx: uint (id: 1, requires_api: 1); // -x face offset in bytes
  py: uint (id: 2, requires_api: 1); // +y face offset in bytes
  ny: uint (id: 3, requires_api: 1); // -y face offset in bytes
  pz: uint (id: 4, requires_api: 1); // +z face offset in bytes
  nz: uint (id: 5, requires_api: 1); // -z face offset in bytes
}

// The dimensions and face offsets of a single mipmap level of a cubemap.
table CubemapLevel (requires_api: 1) {
  // The offset in bytes of each face on the cube.
  face_offsets: FaceOffsets (id: 0, requires_api: 1);

  // The size of each face in bytes.
  face_size: uint (id: 1, requires_api: 1);
}

// The width, height, and bytes of an image.
table ImageContents (requires_api: 1) {
  // The width of the image.
  width: uint (id: 0, requires_api: 1);

  // The height of the image.
  height: uint (id: 1, requires_api: 1);

  // The image data.
  memory: [ubyte] (id: 2, requires_api: 1);
}

// The dimensions and face offsets of a single mipmap level of a cubemap, and
// the corresponding stitched image of the cubemap level.
table CubemapLevelImageContents (requires_api: 1) {
  // The dimensions and face offsets of a single mipmap level of a cubemap.
  cubemap_level: CubemapLevel (id: 0, requires_api: 1);

  // The image of the cubemap level, consisting of six square images stitched
  // together according to the dimensions and offsets in cubemap_level.
  stitched_face_image: ImageContents (id: 1, requires_api: 1);
}

// Spherical harmonics coefficients and number of bands. Used to approximate
// radiance of an Image-Based Lighting (IBL) cubemap. See
// https://google.github.io/filament/Filament.md.html#lighting/imagebasedlights/distantlightprobes
// for an explanation of how Spherical Harmonics are used to approximate IBL
// radiance.
table SphericalHarmonics (requires_api: 1) {
  // The spherical harmonics coefficients.
  coefficients: [Float3] (id: 0, requires_api: 1);

  // The number of spherical harmonics bands.
  num_bands: uint8 (id: 1, requires_api: 1);
}

// The serialized components of an Image-Based Lighting (IBL) asset.
table ImageBasedLightingAsset (requires_api: 1) {
  // The ID of the ImageBasedLightingAsset.
  id: uint64 (id: 0, requires_api: 1);

  // The IBL cubemap image contents for each mipmap level of the cubemap.
  ibl_cubemap_level_image_contents: [CubemapLevelImageContents] (id: 1, requires_api: 1);

  // The skybox cubemap image contents
  skybox_cubemap_level_image_contents: CubemapLevelImageContents (id: 2, requires_api: 1);

  // The spherical harmonics coefficients and number of bands, used in IBL radiance calculations.
  spherical_harmonics: SphericalHarmonics (id: 3, requires_api: 1);
}
// LINT.ThenChange(//depot/google3/third_party/impress/core/split_engine/flatbuffer_size_calculator.cc)


table RemoveNode (requires_api: 1) {
  // Removes the node associated with this client entity id.
  // Does nothing if the node is not found.
  entity: uint32 (id: 0, requires_api: 1);
}

table AssignUserIdToNode (requires_api: 1) {
  // Assigns the user_id to the node associated with this client entity id.
  // Does nothing if the node is not found.
  entity: uint32 (id: 0, requires_api: 1);

  // The user_id to assign.
  user_id: uint64 (id: 1, requires_api: 1);
}

table MorphTargetInfo (requires_api: 1) {
  morph_target_buffer_offset: uint64 (id: 0, requires_api: 1);
  morph_target_buffer_count: uint64 (id: 1, requires_api: 1);
}

table GeometryUpdate (requires_api: 1) {
  vertex_buffer_id: uint64 (id: 0, requires_api: 1); // the VertexBuffer* id
  index_buffer_id: uint64 (id: 1, requires_api: 1); // the IndexBuffer* id
  offset: uint32 (id: 2, requires_api: 1);
  count: uint32 (id: 3, requires_api: 1);
  primitive_type: uint8 (id: 4, requires_api: 1); // TODO: Consider making this an enum.
}

table PrimitiveUpdate (requires_api: 1) {
  // Specifies which primitive index to update within the renderable.
  primitive_index: uint32 (id: 0, requires_api: 1);

  // Updates the geometry of the primitive if set.
  // Otherwise the geometry is left unchanged.
  geometry: GeometryUpdate (id: 1, requires_api: 1);

  // Updates the material of the primitive if set.
  // Otherwise the material is left unchanged.
  material_instance_id: UInt64 (id: 2, requires_api: 1);

  // Updates the blend order of the primitive if set.
  // Otherwise the blend order is left unchanged.
  blend_order: UInt16 (id: 3, requires_api: 1);

  // Updates the global blend order of the renderable if set.
  // Otherwise the global blend order is left unchanged.
  global_blend_order_enabled: Bool (id: 4, requires_api: 1);
}

table RenderableFlags (requires_api: 1) {
  // Whether the renderable is culled based on its bounds.
  culling_enabled: Bool (id: 0, requires_api: 1);
}

table MorphTargetData (requires_api: 1) {
  // The id of the morph target buffer associated with this renderable.
  morph_target_buffer_id: UInt64 (id: 0, requires_api: 1);

  // The morph target info for each primitive.
  morph_target_info: [MorphTargetInfo] (id: 1, requires_api: 1);
}

table AddRenderable (requires_api: 1) {
  // Adds a renderable associated with this client entity id.
  entity: uint32 (id: 0, requires_api: 1);

  // The number of primitives that are rendered by this renderable.
  primitive_count: uint32 (id: 1, requires_api: 1);

  // The number of bones that influence the vertices of this renderable.
  skinning_bone_count: UInt32 (id: 2, requires_api: 1);

  // All the morph target data in a sub-table.
  morph_target_data: MorphTargetData (id: 3, requires_api: 1);

  // Flags such as whether culling is enabled.
  renderable_flags: RenderableFlags (id: 4, requires_api: 1);
}

table UpdateRenderable (requires_api: 1) {
  // Updates the renderable associated with this client entity id.
  // Does nothing if the node is not found.
  entity: uint32 (id: 0, requires_api: 1);

  // Updates the primitives that are rendered by this renderable if set.
  // Otherwise the primitives are left unchanged.
  primitives: [PrimitiveUpdate] (id: 1, requires_api: 1);

  // Updates the bounds of the renderable if set.
  // Otherwise the bounds are left unchanged.
  //
  // The bounds are used for frustum culling.
  bounds: BoundsInfo (id: 2, requires_api: 1);

  // Updates the layer mask of the renderable if set.
  // Otherwise the layer mask is left unchanged.
  //
  // The layer mask is used to control visibility of the renderable.
  layer_mask: LayerMask (id: 3, requires_api: 1);

  // Updates the bones of the renderable if set.
  // Otherwise the bones are left unchanged.
  bones: Bones (id: 4, requires_api: 1);

  // Updates the morph weights of the renderable if set.
  // Otherwise the morph weights are left unchanged.
  morph_weights: MorphWeights (id: 5, requires_api: 1);

  // Updates the priority of the renderable if set.
  // Otherwise the priority is left unchanged.
  priority: UInt8 (id: 6, requires_api: 1);
}

table RemoveRenderable (requires_api: 1) {
  // Removes the renderable associated with this client entity id.
  // Does nothing if the node is not found.
  entity: uint32 (id: 0, requires_api: 1);
}
