enum GsplatMode : int {
  UNSPECIFIED = 0,
  MAGIC_WINDOW = 1,
  GSPLAT = 2,
}

table BuiltInMaterialGsplatSpec {
  // The material mode is used to select the material to render.
  material_mode: GsplatMode (id: 0);
}

table BuiltInMaterialGsplatParameters {
  // Adjust opacity for each splat.
  opacity_scale: Float (id: 0);
  // Clamps the screen size for each splat
  min_screen_size: Float2 (id: 1);
  // Clamps the screen size for each splat
  max_screen_size: Float2 (id: 2);
  // If material_mode is "magic window",
  // this contains the dimension of the renderable area (the dimension of the black quad)
  window_dimension_in_magic_window: Float2 (id: 3);
  // If material_mode is "magic window", this contains thetransform from World Space to Magic Window Space
  // This is necessary to calculate a position in Magic Window space for an eye, a splat, etc
  // Magic Window Space is the world space of magic windows parent node.
  magic_window_from_user_world_matrix: Mat4f (id: 4);
  // If true, precomputed_data_texture is used.
  // If false, position_data_texture, cov3d_data_texture, and color_data_texture
  //are used instead.
  is_splat_data_precomputed: Bool (id: 5);
  // The precomputed data for rendering each splat, packed into an
  // RGBA32F texture. The format expected is:
  // R [2x16F] XY Clip Position of Splat Center
  // G [2x16F] Z Clip Position of Splat Center and Aspect Ratio of Splat
  // B [2x16F] X Basis Vector of Splat in Screen Space
  // A [4x8unorm] RGBA Color of Splat - If A == 0 the splat is disabled.
  precomputed_data_texture: BuiltInTextureParameter (id: 6);
  // Each texel value corresponds to a 3D position for a splat
  // The texture format is RGBA16F. The pixel data format is RGBA. The pixel data type is HALF
  position_data_texture: BuiltInTextureParameter (id: 7);
  // Texels contain a 3D covariance matrix packed into RGB values.
  // The texture format is RGBA32UI. The pixel data format is RGB_INTEGER or
  // RGBA_INTEGER. The pixel data type is UINT
  cov3d_data_texture: BuiltInTextureParameter (id: 8);
  // Texels contain a 3D color.
  // The texture format is RGBA8. The pixel data format is RGBA. The pixel data type is UBYTE
  color_data_texture: BuiltInTextureParameter (id: 9);
  // Texel values control rendering order.
  // The texture format is R32UI. The pixel data format is R_INTEGER. The pixel data type is UINT
  sorted_indices_texture: BuiltInTextureParameter (id: 10);
  // If true, assigns random colors to nearby gsplats.
  // Debugging only: This may be removed in the future.
  visualize_chunks: Bool (id: 11);
  splat_scale: Float (id: 12);
}

table BuiltInMaterialGsplatBackgroundSpec {
}

table BuiltInMaterialGsplatBackgroundParameters {
}

table BuiltInMaterialTextureExternal (requires_api: 1) {
}

table BuiltInMaterialTextureExternalParameters (requires_api: 1) {
  texture: BuiltInTextureParameter (id: 0, requires_api: 1);
}

// Union of all the built-in materials that are supported by Split Engine.
union BuiltInMaterialSpec (requires_api: 1) {
  GenericMaterialSpec = 1 (requires_api: 1),
  BuiltInMaterial5cf26af8 = 2 (requires_api: 1),
  BuiltInMaterialE3ca0ab9 = 3 (requires_api: 1),
  BuiltInMaterialD1750064 = 4 (requires_api: 1),
  BuiltInMaterialEb117dd9 = 5 (requires_api: 1),
  BuiltInMaterial1b616c8a = 6 (requires_api: 1),
  BuiltInMaterial0d0cb9aa = 7 (requires_api: 1),
  BuiltInMaterialTextureExternal = 8 (requires_api: 1),
  BuiltInMaterialbd7fe08c = 9 (requires_api: 1),
  BuiltInMaterialGsplatSpec = 10,
  // TEMPORARY: BuiltInMaterialGsplatBackgroundSpec is experimental and will be
  // replaced by custom materials or another method.  Add new materials above it
  // in the union.
  // TODO: b/450582333 - Replace BuiltInMaterialGsplatBackgroundSpec.
  BuiltInMaterialGsplatBackgroundSpec = 11,
}

// Request to create a built-in material instance and associate it with a
// front-end material instance ID.
table BuiltInMaterialRequest (requires_api: 1) {
  material_instance_id: uint64 (id: 0, requires_api: 1);
  data: BuiltInMaterialSpec (id: 2, requires_api: 1);
}

root_type BuiltInMaterialRequest;

// Each built-in material has a set of parameters that are used to configure the
// material instance.
//
union BuiltInMaterialParameters (requires_api: 1) {
  GenericMaterialParameters = 1 (requires_api: 1),
  BuiltInMaterial5cf26af8Parameters = 2 (requires_api: 1),
  BuiltInMaterialE3ca0ab9Parameters = 3 (requires_api: 1),
  BuiltInMaterialD1750064Parameters = 4 (requires_api: 1),
  BuiltInMaterialEb117dd9Parameters = 5 (requires_api: 1),
  BuiltInMaterial1b616c8aParameters = 6 (requires_api: 1),
  BuiltInMaterial0d0cb9aaParameters = 7 (requires_api: 1),
  BuiltInMaterialTextureExternalParameters = 8 (requires_api: 1),
  BuiltInMaterialbd7fe08cParameters = 9 (requires_api: 1),
  BuiltInMaterialGsplatParameters = 10,
  // TEMPORARY: BuiltInMaterialGsplatBackgroundParameters is experimental and will be
  // replaced by custom materials or another method.  Add new materials above it
  // in the union.
  // TODO: b/450582333 - Replace BuiltInMaterialGsplatBackgroundParameters.
    BuiltInMaterialGsplatBackgroundParameters = 11,
}

table BuiltInMaterialInstanceParameters (requires_api: 1) {
  material_instance_id: uint64 (id: 0, requires_api: 1);
  data: BuiltInMaterialParameters (id: 2, requires_api: 1);
}

root_type BuiltInMaterialInstanceParameters;

// Spec for a filament material.
table FilamentMaterialSpec {
  // The source of the material in the filament "jsonish" text format.
  source: string (id: 0);
  // The precompile options for the material.
  precompile_options: MaterialPrecompileOptions (id: 1);
}

// Spec for a custom material to be compiled and used by Split Engine.
union CustomMaterialSpec {
  FilamentMaterialSpec = 1,
}

// Request to compile a material, defined by a spec.
table AddCustomMaterialRequest {
  // The ID to assign to the material.
  material_id: uint64 (id: 0);
  // The spec for the material to be compiled.
  // Skip id: 1 for spec_type.
  spec: CustomMaterialSpec (id: 2);
}

// LINT.ThenChange(//depot/google3/third_party/split_engine/schemas/split_engine_schema_version.h)
