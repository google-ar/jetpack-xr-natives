enum BuiltInMaterial1b616c8aStereoType : uint8 (requires_api: 1) {
  MONOSCOPIC = 0 (requires_api: 1),
  TOP_BOTTOM = 1 (requires_api: 1),
  LEFT_RIGHT = 2 (requires_api: 1),
  STEREO_MESH = 3 (requires_api: 1),
  INTERLEAVED_LEFT_PRIMARY = 4 (requires_api: 1),
