enum ColorStandard : int (requires_api: 1) {
  // Default value when the color standard is not specified.
  UNSPECIFIED = 0 (requires_api: 1),
  BT709 = 1 (requires_api: 1),
  BT601_PAL = 2 (requires_api: 1),
  BT2020 = 6 (requires_api: 1),
  BT601_525 = 0xf0 (requires_api: 1),
  DISPLAY_P3 = 0xf1 (requires_api: 1),
  DCI_P3 = 0xf2 (requires_api: 1),
  ADOBE_RGB = 0xf3 (requires_api: 1),
}

enum ColorTransfer : int (requires_api: 1) {
  // Default value when the color transfer is not specified.
  UNSPECIFIED = 0 (requires_api: 1),
  LINEAR = 1 (requires_api: 1),
  SRGB = 2 (requires_api: 1),
  SDR = 3 (requires_api: 1),
  GAMMA_2_2 = 10 (requires_api: 1),
  ST2084 = 6 (requires_api: 1),
  HLG = 7 (requires_api: 1),
}

enum ColorRange : int (requires_api: 1) {
  // Default value when the color range is not specified.
  UNSPECIFIED = 0 (requires_api: 1),
  FULL = 1 (requires_api: 1),
  LIMITED = 2 (requires_api: 1),
  EXTENDED = 3 (requires_api: 1),
}

// Color space parameters for JXR media content.
// These parameters (color standard, color transfer, and color range) should be
// set if accurate color correction is required. If any field is UNSPECIFIED,
// these parameters are ignored, and the backend falls back to a best-effort
// color correction mode.
//
// The max_luminance field corresponds to the Max Content Light Level (MaxCLL)
// metadata of the content. It specifies the maximum peak luminance, in nits.
// Max luminance should be between 1 and 65535; a value of 0 is acceptable, and
// indicates that this information is not available. In this case, the backend
// will use the default max luminance value of the transfer function, for
// example, 10000 nits for ST2084, 1000 nits for HLG, etc. If your content is
// professionally mastered and has a lower max luminance, like 500 nits, using
// the default max luminance value results in your content being rendered on the
// screen darker than intended.
//
// In best-effort mode (when any of the color space parameters are UNSPECIFIED),
// the backend attempts to use ADataSpace metadata from the content buffer.
// This metadata is not always available and does not include max content light
// level (MaxCLL). If metadata is absent, the backend assumes sRGB content
// (BT.709 color space, sRGB transfer, full range), which implicitly has a
// standard peak luminance assumption.
//
// For optimal color correction of non-sRGB content, it is highly recommended to
// specify accurate color space parameters, including the correct max content
// light level (MaxCLL), when available from the content metadata. Specifically,
// for HDR videos, you can extract this information from the container using
// ExoPlayer.
table BuiltInMaterial1b616c8aMediaColorSpaceParameter (requires_api: 1) {
  color_standard: ColorStandard (id: 0, requires_api: 1);
  color_transfer: ColorTransfer (id: 1, requires_api: 1);
  color_range: ColorRange (id: 2, requires_api: 1);
  max_luminance: int (id: 3, requires_api: 1);
}

table BuiltInMaterial1b616c8aParameters (requires_api: 1) {
  primary_texture: BuiltInTextureParameter (id: 0, requires_api: 1);
  auxiliary_texture: BuiltInTextureParameter (id: 1, requires_api: 1);
  stereo_type: BuiltInMaterial1b616c8aStereoType (id: 2, requires_api: 1);
  media_color_space: BuiltInMaterial1b616c8aMediaColorSpaceParameter (id: 6, requires_api: 1);
  primary_alpha_mask: BuiltInTextureParameter (id: 3, requires_api: 1);
  auxiliary_alpha_mask: BuiltInTextureParameter (id: 4, requires_api: 1);
  feather_radius: Float2 (id: 5, requires_api: 1);
}

