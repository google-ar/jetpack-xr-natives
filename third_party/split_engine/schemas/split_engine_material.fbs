include "split_engine/schemas/split_engine_attributes.fbs";
include "split_engine/schemas/split_engine_data.fbs";
include "split_engine/schemas/split_engine_primitive.fbs";
include "split_engine/schemas/split_engine_render_passes.fbs";

namespace android_xr.schemas;

// TODO: b/394640352 - Migrate all single-field scalar uppercase struct fields
// to true optionals, i.e. f: Float -> f: float = null.
// This was tested and verified to be a backwards compatible change so it's safe
// to defer.

// LINT.IfChange(generic_material_spec_jni_conversion_schema)

// These enums are used to determine which material to load from the material
// library.
enum GenericMaterialLightingModel : uint8 (requires_api: 1) {
  Lit = 0 (requires_api: 1),
  Unlit = 1 (requires_api: 1),
}

enum GenericMaterialBlendMode : uint8 (requires_api: 1) {
  Opaque = 0 (requires_api: 1),
  Masked = 1 (requires_api: 1),
  Transparent = 2 (requires_api: 1),
  Refractive = 3 (requires_api: 1),
}

enum GenericMaterialDoubleSidedMode : uint8 (requires_api: 1) {
  SingleSided = 0 (requires_api: 1),
  DoubleSided = 1 (requires_api: 1),
}

// If Enabled, a special depth clear material will be loaded instead of a normal
// generic material.
enum GenericMaterialDepthClearMaterial : uint8  (requires_api: 1) {
  Disabled = 0 (requires_api: 1),
  Enabled = 1 (requires_api: 1),
}
// LINT.ThenChange(//depot/google3/third_party/impress/apibindings/jni_conversion_utils.cc:generic_material_spec_jni_conversion_bindings)

// This table is used to determine which material to load from the material
// library.
table GenericMaterialSpec (requires_api: 1) {
  lighting_model: GenericMaterialLightingModel (id: 0, requires_api: 1);
  blend_mode: GenericMaterialBlendMode (id: 1, requires_api: 1);
  double_sided_mode: GenericMaterialDoubleSidedMode (id: 2, requires_api: 1);
  depth_clear_material: GenericMaterialDepthClearMaterial (id: 3, requires_api: 1);
}

root_type GenericMaterialSpec;

// LINT.IfChange(texture_sampler_jni_conversion_schema)

// These enums are used to determine how to sample textures in materials.
enum WrapMode : uint8 (requires_api: 1) {
  CLAMP_TO_EDGE = 0 (requires_api: 1),
  REPEAT = 1 (requires_api: 1),
  MIRRORED_REPEAT = 2 (requires_api: 1),
}

enum MinFilter : uint8 (requires_api: 1) {
  NEAREST = 0 (requires_api: 1),
  LINEAR = 1 (requires_api: 1),
  NEAREST_MIPMAP_NEAREST = 2 (requires_api: 1),
  LINEAR_MIPMAP_NEAREST = 3 (requires_api: 1),
  NEAREST_MIPMAP_LINEAR = 4 (requires_api: 1),
  LINEAR_MIPMAP_LINEAR = 5 (requires_api: 1),
}

enum MagFilter : uint8 (requires_api: 1) {
  NEAREST = 0 (requires_api: 1),
  LINEAR = 1 (requires_api: 1),
}

enum CompareMode : uint8 (requires_api: 1) {
  NONE = 0 (requires_api: 1),
  COMPARE_TO_TEXTURE = 1 (requires_api: 1),
}

enum CompareFunc : uint8 (requires_api: 1) {
  LE = 0 (requires_api: 1),
  GE = 1 (requires_api: 1),
  L = 2 (requires_api: 1),
  G = 3 (requires_api: 1),
  E = 4 (requires_api: 1),
  NE = 5 (requires_api: 1),
  A = 6 (requires_api: 1),
  N = 7 (requires_api: 1),
}

// LINT.ThenChange(//depot/google3/third_party/impress/apibindings/jni_conversion_utils.cc:texture_sampler_jni_conversion_bindings)

table TextureSampler (requires_api: 1) {
  min_filter : MinFilter (id: 0, requires_api: 1);
  mag_filter : MagFilter (id: 1, requires_api: 1);
  wrap_mode_s : WrapMode (id: 2, requires_api: 1);
  wrap_mode_t : WrapMode (id: 3, requires_api: 1);
  wrap_mode_r : WrapMode (id: 4, requires_api: 1);
  compare_mode : CompareMode (id: 5, requires_api: 1);
  compare_func : CompareFunc (id: 6, requires_api: 1);
  anisotropy_log2 : uint8 (id: 7, requires_api: 1);
}

// These tables are used to include various types of parameters in the schema.

// This is the index into the material's texture list.
struct MaterialTextureId (requires_api: 1) {
  index : uint16 (id: 0, requires_api: 1);
}

struct ExternalSampler (requires_api: 1) {
  unused : uint8 (id: 0, requires_api: 1);
}

struct NilValue (requires_api: 1) {
  unused : uint8 (id: 0, requires_api: 1);
}

// This is a union of all the possible types of parameters.
union MaterialParamValue (requires_api: 1) {
  Float = 1 (requires_api: 1),
  Float2 = 2 (requires_api: 1),
  Float3 = 3 (requires_api: 1),
  Float4 = 4 (requires_api: 1),
  Int = 5 (requires_api: 1),
  Int2 = 6 (requires_api: 1),
  Int3 = 7 (requires_api: 1),
  Int4 = 8 (requires_api: 1),
  Bool = 9 (requires_api: 1),
  Bool2 = 10 (requires_api: 1),
  Bool3 = 11 (requires_api: 1),
  Bool4 = 12 (requires_api: 1),
  MaterialTextureId = 13 (requires_api: 1),
  ExternalSampler = 14 (requires_api: 1),
  Mat3f = 15 (requires_api: 1),
  Mat3fVector = 16 (requires_api: 1),
  Mat4f = 17 (requires_api: 1),
  Mat4fVector = 18 (requires_api: 1),
  NilValue = 19 (requires_api: 1),
  Uint = 20,
  Uint2 = 21,
  Uint3 = 22,
  Uint4 = 23,
  FloatVector = 24,
  Float2Vector = 25,
  Float3Vector = 26,
  Float4Vector = 27,
  IntVector = 28,
  Int2Vector = 29,
  Int3Vector = 30,
  Int4Vector = 31,
  UintVector = 32,
  Uint2Vector = 33,
  Uint3Vector = 34,
  Uint4Vector = 35,
  BoolVector = 36,
  Bool2Vector = 37,
  Bool3Vector = 38,
  Bool4Vector = 39,
}

// Possible types of precompile constant values.
union MaterialPrecompileConstantValue (requires_api: 1) {
  Int = 1 (requires_api: 1),
  Float = 2 (requires_api: 1),
  Bool = 3 (requires_api: 1),
}

table MaterialPrecompileOptions (requires_api: 1) {
  precompile_constants: [MaterialPrecompileConstant] (id: 0, requires_api: 1);
}

table MaterialPrecompileConstant (requires_api: 1) {
  name: string (id: 0, requires_api: 1);
  value: MaterialPrecompileConstantValue (id: 2, requires_api: 1); // skip 1 ID for union enum field
}

// This determines how the image data of a texture should be interpreted.
enum TextureInfoFlags : ubyte (bit_flags, requires_api: 1) {
  IsSrgb = 0 (requires_api: 1),        // (1 << 0)
  GenerateMips = 1 (requires_api: 1),  // (1 << 1)
  IsR11G11B10 = 2 (requires_api: 1),   // (1 << 2)
  IsLookup = 3 (requires_api: 1),      // (1 << 3)
}

// This contains the information from a glTF texture definition.
table TextureInfo (requires_api: 1) {
  name: string (required, id: 0, requires_api: 1);
  flags: TextureInfoFlags (id: 1, requires_api: 1);
}

// Captures a material parameter name and generic value union.
// This is used to serialize raw material parameters.
table MaterialParamInfo (requires_api: 1) {
  name : string (required, id: 0, requires_api: 1);
  value : MaterialParamValue (required, id: 2, requires_api: 1);
}

table MaterialParameters (requires_api: 1) {
  material_id: uint64 (id: 0, requires_api: 1);
  params: [MaterialParamInfo] (id: 1, requires_api: 1);
  texture_params: [MaterialTextureParameter] (id: 2, requires_api: 1);
}

table MaterialTextureParameter (requires_api: 1) {
  name: string (id: 0, requires_api: 1);
  texture_id: uint64 (id: 1, requires_api: 1);
  sampler: TextureSampler (id: 2, requires_api: 1);
}

table Material (requires_api: 1) {
  id: uint64 (id: 0, requires_api: 1);
  data: [ubyte] (id: 1, requires_api: 1);
  precompile_options: MaterialPrecompileOptions (id: 2, requires_api: 1);
}

table MaterialInstance (requires_api: 1) {
  instance_id: uint64 (id: 0, requires_api: 1);
  material_id: uint64 (id: 1, requires_api: 1);
}

table DuplicateMaterialInstance (requires_api: 1) {
  duplicate_id: uint64 (id: 0, requires_api: 1);
  original_id: uint64 (id: 1, requires_api: 1);
}

// Defines a texture channel in a generic material.
table GenericMaterialTextureParameter (requires_api: 1) {
  // The index into the loaded model's texture list OR the split-engine ID of
  // the texture.
  texture: uint64 (id: 0, requires_api: 1);
  // The sampler settings to use to sample the texture.
  sampler: TextureSampler (id: 1, requires_api: 1);
  // The UV transform to apply to the texture.
  uv_transform: Mat3f (id: 2, requires_api: 1);
  // If true, UV1 will be used instead of UV0 to sample the texture.
  uses_uv1: Bool (id: 3, requires_api: 1);
}

// The base color (diffuse channel) of the material. This is the color that
// will be used to color the surface.
table GenericMaterialParametersBaseColor (requires_api: 1) {
  // A texture that contains the base color data.
  texture: GenericMaterialTextureParameter (id: 0, requires_api: 1);
  // An optional tint to multiply with the base color.
  factor: Float4 (id: 1, requires_api: 1);
}

// The metallic property defines whether the surface is a metallic (conductor)
// or a non-metallic (dielectric) surface. Non-metallic surfaces have
// chromatic diffuse reflection and achromatic specular reflection (reflected
// light does not change color). Metallic surfaces do not have any diffuse
// reflection and chromatic specular reflection (reflected light takes on the
// color of the surfaced as defined by base color).
// The roughness property controls the perceived smoothness of the surface.
// When roughness is set to 0, the surface is perfectly smooth and highly
// glossy. The rougher a surface is, the “blurrier” the reflections are.
table GenericMaterialParametersMetallicRoughness (requires_api: 1) {
  // A texture that contains the metallic and roughness values.
  texture: GenericMaterialTextureParameter (id: 0, requires_api: 1);
  // A multiplier for the metallic property.
  metallic_factor: Float (id: 1, requires_api: 1);
  // A multiplier for the roughness property.
  roughness_factor: Float (id: 2, requires_api: 1);
}

// Normals are used to compute the lighting direction of a surface.
table GenericMaterialParametersNormal (requires_api: 1) {
  // A texture that contains normal vector data instead of color in XYZW format.
  texture: GenericMaterialTextureParameter (id: 0, requires_api: 1);
  // The scale of the normal vectors since they are normalized in the texture.
  factor: Float (id: 1, requires_api: 1);
}

// The ambientOcclusion property defines how much of the ambient light is
// accessible to a surface point. It is a per-pixel shadowing factor between 0.0
// (fully shadowed) and 1.0 (fully lit).
table GenericMaterialParametersAmbientOcclusion (requires_api: 1) {
  // A texture that contains the ambient occlusion data.
  texture: GenericMaterialTextureParameter (id: 0, requires_api: 1);
  // A multiplier for the ambient occlusion property.
  factor: Float (id: 1, requires_api: 1);
}

// The emissive property defines the light emitted from the surface.
table GenericMaterialParametersEmissive (requires_api: 1) {
  // A texture that contains the emissive color data of the material.
  texture: GenericMaterialTextureParameter (id: 0, requires_api: 1);
  // A multiplier for the emissive property.
  factor: Float3 (id: 1, requires_api: 1);
}

// Defines the clearcoat parameters in a generic material.
table GenericMaterialParametersClearcoat (requires_api: 1) {
  intensity_texture: GenericMaterialTextureParameter (id: 0, requires_api: 1);
  normal_texture: GenericMaterialTextureParameter (id: 1, requires_api: 1);
  roughness_texture: GenericMaterialTextureParameter (id: 2, requires_api: 1);
  factor: Float3 (id: 3, requires_api: 1);
}

// Defines the sheen parameters in a generic material.
table GenericMaterialParametersSheen (requires_api: 1) {
  color_texture: GenericMaterialTextureParameter (id: 0, requires_api: 1);
  color_factor: Float3 (id: 1, requires_api: 1);
  roughness_texture: GenericMaterialTextureParameter (id: 2, requires_api: 1);
  roughness_factor: Float (id: 3, requires_api: 1);
}

// Defines the transmission parameters in a generic material.
table GenericMaterialParametersTransmission (requires_api: 1) {
  texture: GenericMaterialTextureParameter (id: 0, requires_api: 1);
  factor: Float (id: 1, requires_api: 1);
}

// Defines the KHR_materials_volume parameters in a generic material.
table GenericMaterialParametersVolume {
  texture: GenericMaterialTextureParameter (id: 0);
  thickness_factor: Float (id: 1);
  attenuation_distance: Float (id: 2);
  attenuation_color: Float3 (id: 3);
}

// Defines the refraction parameters in a generic material.
table GenericMaterialParametersRefraction (requires_api: 1) {
  index_of_refraction: Float (id: 0, requires_api: 1);
}

// Defines the masking parameters in a generic material.
table GenericMaterialParametersMasking (requires_api: 1) {
  alpha_cutoff: Float (id: 0, requires_api: 1);
}

// Captures all the settings for a generic, physically-based material.
// This is based on the glTF 2.0 material spec.
// https://www.khronos.org/registry/glTF/specs/2.0/glTF-2.0.html#material
table GenericMaterialParameters (requires_api: 1) {
  base_color: GenericMaterialParametersBaseColor (id: 0, requires_api: 1);
  metallic_roughness: GenericMaterialParametersMetallicRoughness (id: 1, requires_api: 1);
  normal: GenericMaterialParametersNormal (id: 2, requires_api: 1);
  ambient_occlusion: GenericMaterialParametersAmbientOcclusion (id: 3, requires_api: 1);
  emissive: GenericMaterialParametersEmissive (id: 4, requires_api: 1);
  clearcoat: GenericMaterialParametersClearcoat (id: 5, requires_api: 1);
  sheen: GenericMaterialParametersSheen (id: 6, requires_api: 1);
  transmission: GenericMaterialParametersTransmission (id: 7, requires_api: 1);
  refraction: GenericMaterialParametersRefraction (id: 8, requires_api: 1);
  masking: GenericMaterialParametersMasking (id: 9, requires_api: 1);
  feature_id_textures: [GenericMaterialTextureParameter] (id: 10);
  volume: GenericMaterialParametersVolume (id: 11);
}

root_type GenericMaterialParameters;

