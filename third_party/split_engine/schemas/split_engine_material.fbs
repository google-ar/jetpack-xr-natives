  TOP_BOTTOM = 1 (requires_api: 1),
  LEFT_RIGHT = 2 (requires_api: 1),
}

table BuiltInMaterialEb117dd9 (requires_api: 1) {
  stereo_type: BuiltInMaterialEb117dd9StereoType (id: 0, requires_api: 1);
}

