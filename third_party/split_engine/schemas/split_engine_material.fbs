}

table BuiltInMaterial1b616c8a (requires_api: 1) {
  shape: BuiltInMaterial1b616c8aShapeType (id: 0, requires_api: 1);
  use_super_sampling: Bool (id: 1, requires_api: 1);
  render_eye_target: BuiltInMaterial1b616c8aRenderEyeTarget (id: 2);
