module(name = "third_party")

bazel_dep(name = "rules_cc", version = "0.1.5")
bazel_dep(name = "abseil-cpp", version = "20250814.1", repo_name = "com_google_absl")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "flatbuffers", version = "25.2.10")
bazel_dep(name = "jsoncpp", version = "1.9.5")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_android", version = "0.6.0", repo_name = "build_bazel_rules_android")
bazel_dep(name = "rules_java", version = "8.6.1")
bazel_dep(name = "rules_jvm_external", version = "6.7")
bazel_dep(name = "rules_license", version = "1.0.0")

single_version_override(
    module_name = "abseil-cpp",
    patch_strip = 1,
    patches = ["@//:com_google_absl.patch"],
)

bazel_dep(name = "com_google_impress")
local_path_override(
    module_name = "com_google_impress",
    path = "../impress",
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
use_repo(maven, "maven")

non_module_repos = use_extension("@com_google_impress//:non_module_dependencies.bzl", "non_module_repos")
use_repo(non_module_repos, "dear_imgui")
use_repo(non_module_repos, "glslang")
use_repo(non_module_repos, "meshoptimizer")
use_repo(non_module_repos, "mikktspace")
use_repo(non_module_repos, "perfetto")
use_repo(non_module_repos, "png")
use_repo(non_module_repos, "robin_map")
use_repo(non_module_repos, "smol_v")
use_repo(non_module_repos, "spirv_cross")
use_repo(non_module_repos, "spirv_headers")
use_repo(non_module_repos, "spirv_tools")
use_repo(non_module_repos, "tinyexr")
use_repo(non_module_repos, "vulkan_memory_allocator")
use_repo(non_module_repos, "zstdlib")
