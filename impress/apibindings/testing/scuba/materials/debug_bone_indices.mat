material {
    name : "Debug Bone Indices",
    shadingModel : unlit,
    culling : none,
    variables : [
        {
            name : boneIndices,
            precision : high
        }
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        #if defined(HAS_ATTRIBUTE_BONE_INDICES)
            material.boneIndices = vec4(mesh_bone_indices);
        #else
            material.boneIndices = vec4(0.0);
        #endif
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = variable_boneIndices;
        material.baseColor.a = 1.0;
    }
}
