# Keeps the Java API to Impress.
-keep class com.google.ar.imp.apibindings.** { *; }
-keep class com.google.ar.imp.apibindings.**$* { *; }

-keep class com.google.ar.imp.view.** { *; }
-keep class com.google.ar.imp.view.**$* { *; }

-keep class com.google.ar.imp.view.input.** { *; }
-keep class com.google.ar.imp.view.input.**$* { *; }

# Keeps the Split Engine infrastructure related to Impress. (API, renderer,
# bridge, etc.)
-keep class com.google.ar.imp.view.splitengine** { *; }
-keep class com.google.ar.imp.view.splitengine.**$* { *; }

# Keeps the wrappers for the xr extensions used by split engine.
-keep class com.google.imp.splitengine.extensions** { *; }
-keep class com.google.imp.splitengine.extensions.**$* { *; }

# Keeps the Split Engine infrastructure related to Android XR. (subspace
# manager, subspace node, etc.)
-keep class com.google.androidxr.splitengine.** { *; }
-keep class com.google.androidxr.splitengine.**$* { *; }

# Prevents the Android Gradle Plugin from issuing a missing class warning.
-dontwarn com.google.ar.imp.core.scripting.ScriptEndpoint
-dontwarn com.google.ar.imp.core.web.FragmentHost
-dontwarn com.google.android.apps.common.proguard.UsedByNative
