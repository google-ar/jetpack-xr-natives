# This proguard is ensures that the classes that the loader isolatedProcess
# requires are in the main dex.  Isolated processes can only load from the main
# dex, otherwise they fail with a permission denied error when reading
# dex_manifest.

-keep public class com.google.ar.imp.view.ipc.LoaderService
-keep class com.google.ar.imp.view.ipc.LoaderService$LoaderServiceImpl { *; }
