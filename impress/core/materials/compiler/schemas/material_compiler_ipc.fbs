namespace imp.schemas;

// This should match the Filament material builder Platform enum:
// http://google3/third_party/filament/libs/filamat/include/filamat/MaterialBuilder.h;l=68
enum Platform : uint8 {
  Desktop,
  Mobile,
  All,
}

// This should match the Filament material builder TargetApi enum:
// http://google3/third_party/filament/libs/filamat/include/filamat/MaterialBuilder.h;l=78
enum TargetApi : uint8 (bit_flags) {
  OpenGL = 0,  // (1 << 0)
  Vulkan = 1,  // (1 << 1)
  Metal = 2,  // (1 << 2)
  WebGPU = 3,  // (1 << 3)
}

// Filament error StatusCodes.
// Note that this does not cover the full list of the absl::StatusCode.
enum ErrorStatusCode : uint8 {
  InvalidArgument,
  Internal,
  Unsupported,
  Cancelled,
}

// This should match the Filament UserVariantFilterBit enum:
// http://google3/third_party/filament/libs/filabridge/include/filament/MaterialEnums.h;l=277
enum VariantFilter : uint32 (bit_flags) {
  DIRECTIONAL_LIGHTING = 0,  // (1 << 0)
  DYNAMIC_LIGHTING = 1,  // (1 << 1)
  SHADOW_RECEIVER = 2,  // (1 << 2)
  SKINNING = 3,  // (1 << 3)
  FOG = 4,  // (1 << 4)
  VSM = 5,  // (1 << 5)
  SSR = 6,  // (1 << 6)
  STE = 7,  // (1 << 7)
}

table Config {
  // The platform to compile for.
  platform: Platform;
  // The target API to compile for.
  target_api: TargetApi;
  // The variant filter bitmask for the material compilation.
  variant_filter: VariantFilter;
}

// Client->Service requests.

table CompileRequest {
  // The source material to compile.
  source_material: string (required);
  // The configuration for the compilation.
  config: Config;
}

table CloseRequest {}

table CancelRequest {
  // The operation ids of the jobs to cancel.
  operation_ids: [uint64];
}

union RequestType {
  CompileRequest,
  CloseRequest,
  CancelRequest,
}

table Request {
  request: RequestType;
  // Operation id allows the client to associate a response with the request.
  // It must be greater than 0 due to implicit field presence.
  operation_id: uint64;
}

root_type Request;

// Service->Client responses.

union ResponseType {
  CompileResponse,
  ErrorResponse,
}

table Response {
  response: ResponseType;
  // Operation id allows the client to associate the response with a request.
  // It must be greater than 0 due to implicit field presence.
  operation_id: uint64;
}

table CompileResponse {
  compiled_material: [ubyte];
}

table ErrorResponse {
  error_status_code: ErrorStatusCode;
  message: string;
}

root_type Response;
