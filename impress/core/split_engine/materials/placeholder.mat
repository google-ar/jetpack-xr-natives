// An unused placeholder material to satisfy the material_id field in the
// BuiltInMaterialRequest.
material {
    name : "Split Engine Placeholder",
    parameters : [],
    requires : [],
    shadingModel : unlit,
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(1, 1, 1, 1);
    }
}
