material {
  name : "GSplat",
  parameters : [
        {
           // A scaling value that is used to control the size of the splats
           // relative to their covariance-matrix defined scale. Mathematically,
           // this is the number of standard deviations away from the gaussian
           // mean we are visualizing.
           type      : float,
           name      : splatScale
        },
        {
           // The precomputed data for rendering each splat, packed into an
           // RGBA32F texture. The format expected is:
           // R = [2x16F] XY Clip Position of Splat Center
           // G = [2x16F] Z Clip Position of Splat Center and Aspect Ratio of Splat
           // B = [2x16F] X Basis Vector of Splat in Screen Space
           // A = [4x8unorm] RGBA Color of Splat - If A == 0 the splat is disabled.
           // In mono, the texture is sampled using a sampler2d. In stereo, this
           // is a texture array and is sampled using a sampler2dArray.
           type      : {PRECOMPUTE_SAMPLER},
           format    : float,
           precision : high,
           name      : splatDataPrecomputed
        },
        {
           // The order in which to render the splats.
           type      : sampler2d,
           format    : uint,
           precision : high,
           name      : sortedIndices
        }
  ],
  constants : [
        {
           // If true, use triangles to render splats (3 vertices). Otherwise,
           // use quads (6 vertices).
           type      : bool,
           name      : useTrianglesForSplats,
           value     : false
        }
  ],
  variables : [
         {
            name : color,
            precision : medium
         },
         {
            name : uvCoord,
            precision : medium
         }
  ],
  vertexDomain : device,
  shadingModel : unlit,
  blending : transparent,
}

vertex {
  #include "gsplat_common.glsl"

  void materialVertex(inout MaterialVertexInputs material) {
    const int kNumVerticesPerSplat = materialConstants_useTrianglesForSplats ? 3 : 6;
    int vertIndex = getVertexIndex();
    int indicesWidth = textureSize(materialParams_sortedIndices, 0).x;
    int splatIndex = int(texelFetch(materialParams_sortedIndices, ivec2(vertIndex / kNumVerticesPerSplat % indicesWidth,
                                                                        vertIndex / kNumVerticesPerSplat / indicesWidth), 0).x);
    int splatDataWidth = textureSize(materialParams_splatDataPrecomputed, 0).x;
    uint4 splatDataPrecomputed = fetchPrecomputedSplatData(splatIndex, splatDataWidth, getEyeIndex(), materialParams_splatDataPrecomputed);
    vec4 color = unpackUnorm4x8(splatDataPrecomputed.w);
    // If splat is disabled, discard
    if (color.a == 0.0)
    {
      material.clipSpaceTransform = mat4(vec4(0), vec4(0), vec4(0), vec4(-2, -2, 0, 1));
      return;
    }
    material.color = color;

    vec2 clipPosXY = unpackHalf2x16(splatDataPrecomputed.x);
    vec2 clipPosZAspectRatio = unpackHalf2x16(splatDataPrecomputed.y);
    vec4 clipPos = vec4(clipPosXY, clipPosZAspectRatio.x, 1.0);

    vec2 basisAxisX = unpackHalf2x16(splatDataPrecomputed.z);
    float xSize = length(basisAxisX);

    vec2 basisAxisXNormalized = basisAxisX / xSize;
    vec2 basisAxisY = vec2(basisAxisXNormalized.y, -basisAxisXNormalized.x) *
                      xSize * clipPosZAspectRatio.y;

    // Scale the quad to go beyond the first stddev of gaussian distribution.
    vec2 vertexCoord = getVertexCoord(vertIndex, materialConstants_useTrianglesForSplats) * materialParams.splatScale;
    // Compute interpolated UV coordinate used to calculate final color in frag.
    material.uvCoord.xy = vertexCoord * .5;
    // Rotate and scale the quad coord based on the gaussian cov2d.
    // getResolution().zw is
    // (1 / viewport_width_pixels, 1 / viewport_height_pixels).
    vec2 clipQuadOffset = (vertexCoord.x * basisAxisX + vertexCoord.y * basisAxisY) * getResolution().zw;
    // Apply the offset. Here we are relying on the clipPos from
    // `splatDataPrecomputed` being normalized (i.e., clipPos.w == 1.0).
    clipPos.xy += clipQuadOffset;
    // Override the clip space position with the newly computed position.
    material.clipSpaceTransform = createClipSpaceTransform(clipPos);
  }
}

fragment {
  precision mediump float;
  precision mediump int;

  void material(inout MaterialInputs material) {
    prepareMaterial(material);
    float dist2 = dot(variable_uvCoord.xy, variable_uvCoord.xy);
    float alpha =  min(0.99, variable_color.a * exp(-dist2));
    // TODO: (broken link) - Measure performance with discard vs just setting opacity to 0
    if (alpha < 1.0/255.0)
        discard;

    material.baseColor = vec4(variable_color.xyz * alpha, alpha);
  }
}

