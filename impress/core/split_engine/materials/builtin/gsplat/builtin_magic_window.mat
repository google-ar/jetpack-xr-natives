// TODO: (broken link) - This needs to apply the change to use precompute texture
// in (broken link)
// after the black screen issue is resolved.

material {
  name : "MagicWindow",
  parameters : [
        // LINT.IfChange
        {
           // A scaling value that is used to control the size of the splats
           // relative to their covariance-matrix defined scale. Mathematically,
           // this is the number of standard deviations away from the gaussian
           // mean we are visualizing.
           type      : float,
           name      : splatScale
        },
        {
           // The position of each gaussian in the scene
           type      : sampler2d,
           format    : float,
           precision : high,
           name      : splatDataPosition
        },
        {
           // The cov3d of each gaussian in the scene
           type      : sampler2d,
           format    : uint,
           precision : high,
           name      : splatDataCov3d
        },
        {
           // The color of each gaussian in the scene
           type      : sampler2d,
           format    : float,
           precision : high,
           name      : splatDataColor
        },
        {
           // The order in which to render the splats.
           type      : sampler2d,
           format    : uint,
           precision : high,
           name      : sortedIndices
        },
        {
           // Debug visualize the splat chunks by overriding the splat colors
           // with a random color based on the splat's associated chunk index.
           type      : bool,
           name      : visualizeChunks
        },
        {
           // The transform from the user world space to the Magic Window space.
           type      : mat4,
           name      : magicWindowFromUserWorldMatrix
        },
        {
           // The dimension of the magic window in the magic window space.
           type      : float2,
           name      : windowDimensionInMagicWindow
        }
        // LINT.ThenChange(
        //   gsplat_material_deserializer.cc,
        //   //depot/google3/third_party/split_engine/schemas/split_engine_material.fbs,
        // )
  ],
  constants : [
        {
           // If true, use triangles to render splats (3 vertices). Otherwise,
           // use quads (6 vertices).
           type      : bool,
           name      : useTrianglesForSplats,
           value     : false
        }
  ],
  variables : [
         {
            name : color,
            precision : medium
         },
         {
            name : uvCoord,
            precision : medium
         },
         splatPosInMagicWindow,
         eyePosInMagicWindow
  ],
  vertexDomain : device,
  shadingModel : unlit,
  depthWrite : false,
  depthCulling : false,
  blending : transparent,
}

vertex {
  #include "gsplat_common.glsl"

  // (broken link)
  vec3 rand(int i){
        ivec3 col = i * ivec3(158, 2*156, 3*159);
        col = col % ivec3(255, 253, 256); // skips some channel values
        return vec3(col) / 255.0;
  }

  void materialVertex(inout MaterialVertexInputs material) {
    const int kNumVerticesPerSplat = materialConstants_useTrianglesForSplats ? 3 : 6;
    int vertIndex = getVertexIndex();
    int indicesWidth = textureSize(materialParams_sortedIndices, 0).x;
    int splatIndex = int(texelFetch(materialParams_sortedIndices, ivec2(vertIndex / kNumVerticesPerSplat % indicesWidth,
                                                                        vertIndex / kNumVerticesPerSplat / indicesWidth), 0).x);

    mat4 magicWindowFromUserWorld = materialParams.magicWindowFromUserWorldMatrix;
    mat4 viewFromEye = inverse(getEyeFromViewMatrix());
    mat4 userWorldFromEye =
        getUserWorldFromWorldMatrix() * getWorldFromViewMatrix() * viewFromEye;
    vec4 eyePosInUserWorld = vec4(userWorldFromEye[3].xyz, 1.0);
    material.eyePosInMagicWindow = magicWindowFromUserWorld * eyePosInUserWorld;

    ivec2 sampleCoord = getSampleCoord(splatIndex, /*stride=*/1, materialParams_splatDataPosition);

    // Pull position from splat data.
    vec4 position = texelFetch(materialParams_splatDataPosition, sampleCoord, 0);
    // Pull cov3d from splat data.
    uint4 cov3dPacked = texelFetch(materialParams_splatDataCov3d, sampleCoord, 0);
    mat3 cov3d = unpackCov3d(cov3dPacked.xyz);

    vec4 clipPos;
    vec2 basisAxisX;
    float aspectRatio;
#if defined(VARIANT_HAS_STEREO)
   int eyeIndex = getEyeIndex();
#else
   int eyeIndex = -1;
#endif
    computeSplatData(eyeIndex, position, cov3d, getWorldFromModelMatrix(),
                     /*resolution=*/getResolution().xy,
                     /*minSize=*/vec2(0.1, 0.1),
                     /*maxSize=*/getResolution().xy * 0.5,
                     clipPos,
                     basisAxisX,
                     aspectRatio);
    // computeSplatData() sets clipPos.w to 0.0 if the splat is behind the
    // camera.
    if (clipPos.w == 0.0) {
      material.clipSpaceTransform = mat4(vec4(0), vec4(0), vec4(0), vec4(-2, -2, 0, 1));
      return;
    }

    // Pull color from splat data.
    material.color = texelFetch(materialParams_splatDataColor, sampleCoord, 0);
    if (materialParams.visualizeChunks)
    {
      int chunkIndex = splatIndex / 256;
      material.color.rgb = rand(chunkIndex);
    }

    // Compute NDC coordinate for the current vertex of the triangle on the quad
    // representing this splat.
    // Scale the quad to go beyond the first stddev of gaussian distribution.
    vec2 vertexCoord = getVertexCoord(vertIndex, materialConstants_useTrianglesForSplats) * materialParams.splatScale;
    // Compute interpolated UV coordinate used to calculate final color in frag.
    material.uvCoord.xy = vertexCoord * .5;
    // Rotate and scale the quad coord based on the gaussian cov2d.
    vec2 basisAxisY = vec2(basisAxisX.y, -basisAxisX.x) * aspectRatio;
    // getResolution().zw is
    // (1 / viewport_width_pixels, 1 / viewport_height_pixels).
    vec2 clipQuadOffset = (vertexCoord.x * basisAxisX + vertexCoord.y * basisAxisY) * getResolution().zw;
    // Apply the offset. Here we are assuming computeSplatData() already
    // normalize the clipPos, so clipPos.w == 1.0.
    clipPos.xy += clipQuadOffset;

    // Find the position of the splat in Magic Window Space.
    // We need to use inverse(getClipFromWorldMatrix()) instead of
    // getWorldFromClipMatrix() because the latter does not support stereo per-eye matrix.
    mat4 magicWindowFromClip =
        magicWindowFromUserWorld * getUserWorldFromWorldMatrix() * inverse(getClipFromWorldMatrix());
    material.splatPosInMagicWindow = magicWindowFromClip * clipPos;
    material.splatPosInMagicWindow =
        material.splatPosInMagicWindow / material.splatPosInMagicWindow.w;

    // Override the clip space position with the newly computed position.
    material.clipSpaceTransform = createClipSpaceTransform(clipPos);
  }
}

fragment {
  // Projects `splatPosition` toward `cameraPosition` onto the XY-plane passing
  // through the origin.
  vec2 calculateProjectedPosition(vec4 cameraPosition, vec4 splatPosition) {
    float xDiff = splatPosition.x - cameraPosition.x;
    float yDiff = splatPosition.y - cameraPosition.y;
    float zDiff = cameraPosition.z - splatPosition.z;
    return vec2(
      cameraPosition.x + (cameraPosition.z / zDiff) * xDiff,
      cameraPosition.y + (cameraPosition.z / zDiff) * yDiff
      );
  }

  bool isOutsideRenderableArea(vec2 projectedPosition, float2 dimension) {
    return projectedPosition.x < -(dimension.x * 0.5)
        || (dimension.x * 0.5) < projectedPosition.x
        || projectedPosition.y < -(dimension.y * 0.5)
        || (dimension.y * 0.5) < projectedPosition.y;
  }

  // This method returns the signed distance to the boundary of a rounded-corner
  // rectangle centered at (0, 0), with specified `halfDimension` and rounded
  // corner `radius`. Positive distance means outside of the rectangle.
  // Methodology: (broken link)/@solidalloy/drawing-rounded-corners-and-borders-with-sdf-part-1-rounded-corners-8017bb6ce6f9
  float sdfRoundedCornerRectangle(vec2 position, vec2 halfDimensions, float radius) {
    vec2 cornerCircleCenter = halfDimensions - radius;
    vec2 positionFromCornerCircleCenter = abs(position) - cornerCircleCenter;
    return length(max(positionFromCornerCircleCenter, 0.0)) + min(max(positionFromCornerCircleCenter.x, positionFromCornerCircleCenter.y), 0.0) - radius;
  }

  void material(inout MaterialInputs material) {
    prepareMaterial(material);

    float dist2 = dot(variable_uvCoord.xy, variable_uvCoord.xy);
    float alpha =  min(0.99, variable_color.a * exp(-dist2));

    // TODO: (broken link) - Measure performance with discard vs just setting opacity to 0
    if (alpha < 1.0/255.0)
        discard;

    // Draw a ray from the camera to the splat and calculate a hit
    // (i.e. projected position) in the magic window space.
    vec2 projectedPositionInMagicWindow =
        calculateProjectedPosition(
          variable_eyePosInMagicWindow, variable_splatPosInMagicWindow);

    if (
      isOutsideRenderableArea(
        projectedPositionInMagicWindow,
        materialParams.windowDimensionInMagicWindow)) {
        discard;
    }

    // Based on the design guideline at (broken link),
    // 1024 dp = 1556.24 mm, so to have 32 dp rounded corner radius, the radius
    // in meters is 32dp x 1556.24mm / 1024dp = 0.0486m
    float cornerRadiusInMeters = 0.0486;

    vec2 halfDimensions = vec2(
      materialParams.windowDimensionInMagicWindow.x / 2.0,
      materialParams.windowDimensionInMagicWindow.y / 2.0);
    float distance = sdfRoundedCornerRectangle(
      projectedPositionInMagicWindow, halfDimensions, cornerRadiusInMeters);

    // If the signed distance is positive, it means the fragment is outside the
    // rounded-corner rectangle, so we set the alpha accordingly not to render.
    if (distance > 0.0) {
      float edgeWidth = fwidth(distance);
      alpha = 1.0 - smoothstep(-edgeWidth, edgeWidth, distance);
    }

    material.baseColor = vec4(variable_color.xyz * alpha, alpha);
  }
}
