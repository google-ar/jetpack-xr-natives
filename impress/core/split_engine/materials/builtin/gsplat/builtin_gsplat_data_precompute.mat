material {
  name : "GSplatDataPrecompute",
  parameters : [
        // LINT.IfChange
        {
           // The minimum Screen Size to clamp each Splat to (units are in pixels)
           // NOTE: this value should be greater than or equal to zero
           type       : float2,
           name       : minScreenSize
        },
        {
           // The maximum Screen Size to clamp each Splat to (units are in pixels)
           // NOTE: this value should be greater than minScreenSize
           type       : float2,
           name       : maxScreenSize
        },
        {
           // The position of each gaussian in the scene
           type      : sampler2d,
           format    : float,
           precision : high,
           name      : splatDataPosition
        },
        {
           // The cov3d of each gaussian in the scene
           type      : sampler2d,
           format    : uint,
           precision : high,
           name      : splatDataCov3d
        },
        {
           // The color of each gaussian in the scene
           type      : sampler2d,
           format    : float,
           precision : high,
           name      : splatDataColor
        },
        {
           // The physical pixel resolution of the main camera's view.
           type      : uint2,
           name      : mainViewResolution
        },
        {
           // Debug visualize the splat chunks by overriding the splat colors
           // with a random color based on the splat's associated chunk index.
           type      : bool,
           name      : visualizeChunks
        },
        {
           // Controls the opacity of the splats' colors.
           type      : float,
           name      : opacityScale
        }
        // LINT.ThenChange(
        //   gsplat_material_deserializer.cc,
        //   //depot/google3/third_party/split_engine/schemas/split_engine_material.fbs,
        // )
  ],
  constants : [
        {
           // TODO: Remove this once we have uint render targets.
           // a workaround for Metal devices where packing bits into floats can
           // result in values being dropped entirely.
           type      : float,
           name      : fix,
           value     : 0.0
        }
  ],
  variables : [
        hasStereoAndEyeIndex //stereo info must be passed from fs to vs.
  ],
  flipUV : false,
  vertexDomain : device,
  depthWrite : false,
  depthCulling : false,
  shadingModel : unlit,
  variantFilter : [ skinning, shadowReceiver ],
  culling : none,
  blending : opaque,
  interpolation : flat,
  apiLevel : 2,
}

vertex {
  void materialVertex(inout MaterialVertexInputs material) {
#if defined(VARIANT_HAS_STEREO)
   material.hasStereoAndEyeIndex.x = float(getEyeIndex());
#else
   material.hasStereoAndEyeIndex.x = -1.0;
#endif
  }
}

fragment {
  // By default in fragment shaders, GLES defines int types as mediump and has
  // no default precision for float types.
  // When using ints to define indexes into splat data, mediump uint range of 
  // [0, 2^16-1] is too small for most scenes which can easily contain more than
  // 100000 splats.
  // So we define the int types as highp and the float types as highp to ensure
  // we have enough precision for the fragment shader.
  precision highp float;
  precision highp int;

  #include "gsplat_common.glsl"


  // (broken link)
  vec3 rand(int i) {
        ivec3 col = i * ivec3(158, 2*156, 3*159);
        col = col % ivec3(255, 253, 256); // skips some channel values
        return vec3(col) / 255.0;
  }

  void material(inout MaterialInputs material) {
    prepareMaterial(material);

    int splatIndex = int(floor(gl_FragCoord.y) * getResolution().x + floor(gl_FragCoord.x));
    ivec2 sampleCoord = getSampleCoord(splatIndex, /*stride=*/1, materialParams_splatDataPosition);

    // Pull position from splat data.
    vec4 position = texelFetch(materialParams_splatDataPosition, sampleCoord, 0);

    // Pull cov3d from splat data.
    uint4 cov3dPacked = texelFetch(materialParams_splatDataCov3d, sampleCoord, 0);
    mat3 cov3d = unpackCov3d(cov3dPacked.xyz);
    int eyeIndex = int(variable_hasStereoAndEyeIndex.x);
    vec4 clipPos;
    vec2 basisAxisX;
    float aspectRatio;

    computeSplatData(eyeIndex, position, cov3d, getWorldFromModelMatrix(),
                     vec2(materialParams.mainViewResolution),
                     materialParams.minScreenSize, materialParams.maxScreenSize,
                     clipPos, basisAxisX, aspectRatio);
    // computeSplatData() sets clipPos.w to 0.0 if the splat is behind the
    // camera.

    // Pull color from splat data.
    ivec2 sampleCoordColor = getSampleCoord(splatIndex, 1, materialParams_splatDataColor);
    vec4 color = texelFetch(materialParams_splatDataColor, sampleCoordColor, 0);
    if (materialParams.visualizeChunks) {
      int chunkIndex = splatIndex / 256;
      color.rgb = rand(chunkIndex);
    }
    color.a *= materialParams.opacityScale;

    // If the splat is behind the camera, discard it.
    if (clipPos.w == 0.0) {
      color.a = 0.0;
    }

    material.baseColor = vec4(uintBitsToFloat(packHalf2x16(clipPos.xy)) + materialConstants_fix,
                              uintBitsToFloat(packHalf2x16(vec2(clipPos.z, aspectRatio))) + materialConstants_fix,
                              uintBitsToFloat(packHalf2x16(basisAxisX)) + materialConstants_fix,
                              uintBitsToFloat(packUnorm4x8(color)) + materialConstants_fix);
  }
}
