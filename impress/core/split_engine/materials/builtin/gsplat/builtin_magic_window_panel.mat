material {
  name : "MagicWindowPanel",
  blending : opaque,
  parameters: [
    {type: {PRECOMPUTE_SAMPLER}, name: baseColor }
  ],
  requires: [ uv0 ],
  shadingModel: unlit,
  variables : [
        // Stereo info must be passed from vs to fs.
        hasStereoAndEyeIndex
  ]
}

vertex {
  void materialVertex(inout MaterialVertexInputs material) {
#if defined(VARIANT_HAS_STEREO)
   material.hasStereoAndEyeIndex.x = float(getEyeIndex());
#else
   material.hasStereoAndEyeIndex.x = 0.0;
#endif
  }
}

fragment {
  // By default in fragment shaders, GLES defines int types as mediump and has
  // no default precision for float types.
  // When using ints to define indexes into splat data, mediump uint range of
  // [0, 2^16-1] is too small for most scenes which can easily contain more than
  // 100000 splats.
  // So we define the int types as highp and the float types as highp to ensure
  // we have enough precision for the fragment shader.
  precision highp float;
  precision highp int;

  // sampleTexture is overloaded to support both 2D and 2D array textures.
  vec4 sampleTexture(sampler2D tex, vec3 uvw) {
    return texture(tex, uvw.xy);
  }
  vec4 sampleTexture(sampler2DArray tex, vec3 uvw) {
    return texture(tex, uvw);
  }
  void material(inout MaterialInputs material) {
    prepareMaterial(material);
    vec2 uv = uvToRenderTargetUV(getUV0());
    uv.y = 1.0 - uv.y;
    vec3 uvw = vec3(uv, variable_hasStereoAndEyeIndex.x);
    material.baseColor = sampleTexture(materialParams_baseColor, uvw);

    // Despite the blending mode is opaque, it seems we still need to set the
    // algha to 1.0, or otherwise the rendering can still be transparent if the
    // texture contains transparency.
    material.baseColor.a = 1.0;
  }
}
