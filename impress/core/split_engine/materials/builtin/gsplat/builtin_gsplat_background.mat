// Black background that is rendered behind gsplat.
//
// Required for gsplat to display correctly, along with 
// the other requirements including: specific alpha blending, depth testing, and
// rendering order attributes.
//
// TODO: malikcoates - BuiltInMaterialGsplatBackground is a placeholder. Once we
// have custom materials that should replace this material. Alternatively if a
// stencil buffer is used this will not be needed. 
material {
  name : "GsplatBackground",
  vertexDomain : object,
  blending : transparent,
  shadingModel : unlit,
  depthWrite : false,
  depthCulling : false
}


fragment {
  void material(inout MaterialInputs material) {
    prepareMaterial(material);
    material.baseColor = vec4(0.0, 0.0, 0.0, 1.0);
  }
}
