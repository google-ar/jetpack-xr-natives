// A shader for rendering an external texture.
material {
    name : "TextureExternal",
    constants : [
        {
            name : enableColorConversion,
            type : bool,
            default : false
        }
    ],
    parameters : [
        {
            type : samplerExternal,
            name : texture,
        }
    ],
    requires : [
        uv0
    ],
    flipUV: false,
    blending : transparent,
    shadingModel : unlit,
    culling : none,
    featureLevel : 0
}
fragment {
#include "color_conversion_helpers.glsl"

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        // We want the texture to render forwards regardless of facing.
        highp vec2 uv = getUV0();
        if (!gl_FrontFacing) {
          uv.x = 1.0 - uv.x;
        }

        // Assume alpha is not pre-multiplied into RGB. This is necessary to
        // correctly apply inverse tonemapping to the input sRGB texture values.
        vec4 srgb_color = texture(materialParams_texture, uv);
        material.baseColor = vec4(
            inverseTonemapSRGB(srgb_color.rgb) * srgb_color.a, srgb_color.a);
        if (materialConstants_enableColorConversion) {
            material.baseColor.xyz = applyGlobalMaterialConversionMatrix(material.baseColor.xyz);
        }
    }
}
