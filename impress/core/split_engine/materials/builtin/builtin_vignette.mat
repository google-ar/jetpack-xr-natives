material {
    name : Vignette,
    constants : [
        {
            name : enableColorConversion,
            type : bool,
            default : false
        }
    ],
    parameters: [
        {
            type: float4,
            name: color
        },
        {
            type: float,
            name: coverage
        },
        {
            type: float,
            name: feather
        }
    ],
    variables : [
        // Captures whether the material is being used in stereo mode or not at 'x'
        // If true, captures the index of the camera eye at 'y'
        // 0.0 is the left eye, 1.0 is the right eye.
        stereoData
    ],
    vertexDomain: device,
    vertexDomainDeviceJittered: true,
    depthWrite: false,
    depthCulling: false,
    shadingModel: unlit,
    blending: multiply,
    culling: none
}
vertex {
  void materialVertex(inout MaterialVertexInputs material) {
    #if defined(VARIANT_HAS_STEREO)
        material.stereoData.x = 1.0;
        material.stereoData.y = (getEyeIndex() % 2 < 1) ? 1.0 : 0.0;
    #else
        material.stereoData.x = 0.0;
    #endif
    }
}

fragment {
#include "color_conversion_helpers.glsl"

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 uv = getNormalizedViewportCoord().xy;
        vec2 focus = vec2(0.5, 0.5);
        float view_distance = distance(uv, focus);

        float coverageEdge = materialParams.coverage;
        float featherStart = coverageEdge - materialParams.feather;
        float featherEnd = coverageEdge + materialParams.feather;

        vec4 colorSource = materialParams.color;
        vec4 colorDest = vec4(1, 1, 1, 1);

        vec4 color = colorSource;

        bool isBetweenEyes = false;
        if(variable_stereoData.x > 0.0)
        {
            if(variable_stereoData.y > 0.5)
            {
                isBetweenEyes = focus.x - uv.x < 0.0;
            }
            else
            {
                isBetweenEyes = uv.x - focus.x < 0.0;
            }
        }
        // We want to only apply the y distance here to have more of a "helmet" effect when using stereo.
        if (isBetweenEyes) {
            view_distance = distance(uv.y, focus.y);
        }
        if (view_distance < coverageEdge) {
            if (view_distance >= featherStart) {
                float t = smoothstep(featherStart, coverageEdge, view_distance);
                color = mix(colorDest, colorSource, t);
            } else {
                color = colorDest;
            }
        }

        material.baseColor = color;
        if (materialConstants_enableColorConversion) {
            material.baseColor.xyz = applyGlobalMaterialConversionMatrix(material.baseColor.xyz);
        }
    }
}
