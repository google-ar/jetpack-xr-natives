material {
    "name" : "JXR Media Flat Plane",
    constants : [
        {
            // Only applies a global color conversion matrix.
            name : enableColorConversion,
            type : bool,
            default : false
        },
        {
            name : useSuperSampling,
            type : bool,
            default : false
        },
        {
            // Enables a comprehensive color correction pipeline, encompassing:
            // - Color conversion
            // - Transfer function application
            // - Color range adjustment
            // - Peak luminance handling (for HDR tonemapping)
            // TODO : Clean up once it's no longer needed.
            name : enableColorCorrection,
            type : bool,
            default : true
        },
        {
          // Indicates which eye this material is for.
          // 0 = both, 1 = left, 2 = right.
          type: int,
          name: renderEyeTarget,
          // default is kRenderEyeTargetBoth
          default: 0
        }
    ],
    "parameters" : [
        {
          // The texture displaying the primary view of the media.
          "type" : {SAMPLER_EXTERNAL},
          "name" : mediaTexture
        },
        {
          // The texture displaying the secondary view of the media.
          // This is only used for interleaved stereo content.
          type : {SAMPLER_EXTERNAL},
          name : mediaAuxiliaryTexture
        },
        {
          // Composited into the alpha channel of the media texture.
          "type" : sampler2d,
          "name" : primaryAlphaMaskTexture
        },
        {
          // Composited into the alpha channel of the secondary view of the
          // media texture.
          // This is only used for interleaved stereo content.
          type : sampler2d,
          name : auxiliaryAlphaMaskTexture
        },
        { type: int, name: stereoType },
        {
          // radius for feathering the edges of the quad in UV space
          type : float2,
          name : featherRadius
        },
        {
          // radius for rounding the corners of the quad in UV space
          type : float2,
          name : cornerRadius
        },
        {
          // Represents the subRectangle of the media texture to be displayed:
          // [uMin, vMin, width, height].
          type : float4,
          name : leftEyeViewRect,
          default: [0.0, 0.0, 1.0, 1.0]
        },
        {
          // Represents the subRectangle of the media texture to be displayed:
          // [uMin, vMin, width, height].
          type : float4,
          name : rightEyeViewRect,
          default: [0.0, 0.0, 1.0, 1.0]
        },
        // Below three parameters are used for color correction.
        // TODO - (broken link): Move max luminance float conversion out of the
        // material and pass a float instead.
        {
          name : maxContentLightLevel,
          type : int,
          default : 0
        },
        {
          name: colorConversionMatrix,
          type: float3x3
        },
        {
          // When unset, it defaults to linear.
          name: transferFunction,
          type: int,
          default: 1
          // Expected values:
          // 1: Linear
          // 2: SRGB
          // 3: SMPTE170M
          // 10: Gamma22
          // 6: ST2084
          // 7: HLG
          // Source: (broken link)
        }
    ],
    "requires" : [
        "uv0"
    ],
    variables : [
        // Captures whether the material is being used in stereo mode
        //    or not at 'x'
        // If true, captures the index of the camera eye at 'y'
        // 0.0 is the left eye, 1.0 is the right eye.
        stereoData
    ],
    "shadingModel" : "unlit",
    "flipUV" : false,
    // {DEPTH_CULLING} is replaced by the build system.
    depthCulling: {DEPTH_CULLING},
    culling: none,
    // {BLENDING_MODE} is replaced by the build system.
    blending : {BLENDING_MODE}
}

vertex {
#include "stereo.glsl"
  void materialVertex(inout MaterialVertexInputs material) {
#if defined(VARIANT_HAS_STEREO)
    material.stereoData.x = 1.0;
    material.stereoData.y = (getEyeIndex() % 2 < 1) ? 0.0 : 1.0;
#else
    material.stereoData.x = 0.0;
#endif
    bool isLeftEye = (material.stereoData.y < 1.0);
    bool correctEye =
        (materialConstants_renderEyeTarget == kRenderEyeTargetBoth) ||
        (materialConstants_renderEyeTarget == kRenderEyeTargetLeft &&
            isLeftEye) ||
        (materialConstants_renderEyeTarget == kRenderEyeTargetRight &&
            !isLeftEye);

    // Force all the vertices to be at the same position so that we don't
    // generate any triagles. This means we also don't need to handle anything
    // in the fragment as all the triangles are thrown away.
    if (!correctEye) {
      material.worldPosition = vec4(0.0, 0.0, 0.0, 1.0);
    }
  }
}

fragment {
#include "color_conversion_helpers.glsl"
#include "dataspace_support.glsl"
#include "stereo.glsl"
#include "super_sample.glsl"

  void material(inout MaterialInputs material) {
    prepareMaterial(material);
    bool isLeftEye = (variable_stereoData.y < 1.0);
    highp float4 eyeRect = isLeftEye ? materialParams.leftEyeViewRect : materialParams.rightEyeViewRect;
    // Making this a highp slightly sharpens the resulting image.
    highp vec2 uv = CalculateStereoUvs(getUV0(), eyeRect);

    if (!gl_FrontFacing) {
      uv.x = 1.0 - uv.x;
    }
    vec2 media_uv = uv;
    media_uv.y = 1.0 - media_uv.y;

    vec4 alphaMaskColor = vec4(0.0, 0.0, 0.0, 1.0);
    vec4 textureColor = vec4(0.0);
    highp vec2 alpha_uv = getUV0();

    #define SAMPLE_TEXTURE(sampler, uv, color) \
      if (materialConstants_useSuperSampling) { \
        SUPER_SAMPLE_INTO(sampler, uv, color); \
      } else { \
        color = texture(sampler, uv); \
      }

    #define SAMPLE_ALPHA_TEXTURE(sampler, uv, color) \
      if ({IS_OPAQUE}) { \
        color = vec4(0.0, 0.0, 0.0, 1.0); \
      } else { \
        SAMPLE_TEXTURE(sampler, uv, color); \
      }

    if (variable_stereoData.x > 0.0 &&
        materialParams.stereoType == kInterleavedLeftPrimary) {
      if (variable_stereoData.y == 0.0) {
        SAMPLE_TEXTURE(materialParams_mediaTexture, media_uv, textureColor);
        SAMPLE_ALPHA_TEXTURE(materialParams_primaryAlphaMaskTexture, uv, alphaMaskColor);
      } else {
        SAMPLE_TEXTURE(materialParams_mediaAuxiliaryTexture, media_uv, textureColor);
        SAMPLE_ALPHA_TEXTURE(materialParams_auxiliaryAlphaMaskTexture, uv, alphaMaskColor);
      }
    } else if (variable_stereoData.x > 0.0 &&
               materialParams.stereoType == kInterleavedRightPrimary) {
      if (variable_stereoData.y == 0.0) {
        SAMPLE_TEXTURE(materialParams_mediaAuxiliaryTexture, media_uv, textureColor);
        SAMPLE_ALPHA_TEXTURE(materialParams_auxiliaryAlphaMaskTexture, uv, alphaMaskColor);
      } else {
        SAMPLE_TEXTURE(materialParams_mediaTexture, media_uv, textureColor);
        SAMPLE_ALPHA_TEXTURE(materialParams_primaryAlphaMaskTexture, uv, alphaMaskColor);
      }
    } else {
      SAMPLE_TEXTURE(materialParams_mediaTexture, media_uv, textureColor);
      SAMPLE_ALPHA_TEXTURE(materialParams_primaryAlphaMaskTexture, uv, alphaMaskColor);
    }

    textureColor.a *= alphaMaskColor.a;

    // determine feathered alpha based on the UVs
    float alpha =
      getEdgeFeatheredAlpha(
        alpha_uv, materialParams.featherRadius, materialParams.cornerRadius.xy);

    if ({IS_OPAQUE}) {
      if (alpha == 0.0) {
        // Discard fragments with zero alpha to cut rounded corners.
        discard;
      }
      alpha = 1.0;
      // Ignore texture alpha for opaque materials.
      textureColor.a = 1.0;
    }

    alpha *= textureColor.a;

    if (materialConstants_enableColorCorrection) {
      material.baseColor = vec4(convertColor(textureColor.rgb, materialParams.colorConversionMatrix) * alpha, alpha);
    } else if (materialConstants_enableColorConversion) {
      material.baseColor = vec4(sRGBToLinear(textureColor).rgb*alpha, alpha);
      material.baseColor.xyz =
        applyGlobalMaterialConversionMatrix(material.baseColor.xyz);
    } else {
      material.baseColor = vec4(sRGBToLinear(textureColor).rgb*alpha, alpha);
    }
  }
}

