              float_value: 10.0
            }
          }
        ]
        recipe_nodes: [
          {
            id: {
              index: 0
            }
            value_node: {
              identifier: {
                name: "NodeSelf"
              }
            }
          },
          {
            id: {
              index: 1
            }
            value_node: {
              identifier: {
                name: "target_x_position"
              }
            }
          },
          {
            id: {
              index: 2
            }
            event_node: {
              event_name: "OnStartEvent"
              next_node: {
                node_id: {
                  index: 4
                }
              }
            }
          },
          {
            id: {
              index: 3
            }
            event_node: {
