// A screen space shader for external texture with the outline rendering for the
// debugging purpose.
material {
    name : "Quad",
    parameters : [
        {
            type : samplerExternal,
            name : BaseColor,
        },
        {
          type : "mat4",
          name : clipSpaceTransform,
        },
        {
            type : float4,
            name : color,
        },
        {
            type : float4,
            name : outlineColor,
        },
        {
           // UV bounds as [min_x, min_y, width, height].
           type: float4,
           name: displayedUVBounds,
        }
    ],
    requires : [
        uv0
    ],
    vertexDomain : device,
    vertexDomainDeviceJittered: true,
    flipUV: false,
    blending : transparent,
    depthWrite : false,
    depthCulling : false,
    shadingModel : unlit,
    featureLevel : 0
}
vertex {
    void materialVertex(inout MaterialVertexInputs material) {
       material.clipSpaceTransform = materialParams.clipSpaceTransform;
    }
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        // If any one of the barycentric coordinates is within a certain
        // distance to zero, we want to color that part of the triangle as
        // red. This causes the desired effect of rendering the outlines of
        // the sprite in red.
        float outline_width = 0.03;
        vec2 barycentric = getUV0();
        float barycentric_factor =
            ceil(barycentric.x - outline_width) *
            ceil(barycentric.y - outline_width) *
            ceil(1.0 - outline_width - barycentric.x) *
            ceil(1.0 - outline_width - barycentric.y);

        float2 uv = materialParams.displayedUVBounds.xy
            + getUV0() * materialParams.displayedUVBounds.zw;
        vec4 srgb_color = mix(materialParams.outlineColor,
          texture(materialParams_BaseColor, uv) * materialParams.color,
          barycentric_factor);
        // Convert from sRGB color space to linear for (broken link), and then
        // pre-multiply alpha into RGB.
        material.baseColor = vec4(
            pow(srgb_color.rgb, vec3(2.2)) * srgb_color.a, srgb_color.a);
    }
}
