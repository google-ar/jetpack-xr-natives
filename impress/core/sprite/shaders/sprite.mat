// A screen space shader.
material {
    name : "Quad",
    parameters : [
        {
            type : sampler2d,
            name : BaseColor,
        },
        {
          type : "mat4",
          name : clipSpaceTransform,
        },
        {
            type : float4,
            name : color,
        },
        {
           // UV bounds as [min_x, min_y, width, height].
           type: float4,
           name: displayedUVBounds,
        }
    ],
    requires : [
        uv0
    ],
    vertexDomain : device,
    vertexDomainDeviceJittered: true,
    flipUV: false,
    blending : transparent,
    depthWrite : false,
    depthCulling : false,
    shadingModel : unlit,
    featureLevel : 0
}
vertex {
    void materialVertex(inout MaterialVertexInputs material) {
       material.clipSpaceTransform = materialParams.clipSpaceTransform;
    }
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        float2 uv = materialParams.displayedUVBounds.xy
            + getUV0() * materialParams.displayedUVBounds.zw;

        // Assume alpha is not pre-multiplied into RGB. This is necessary to
        // correctly apply inverse tonemapping to the input sRGB texture values.
        vec4 srgb_color = texture(materialParams_BaseColor, uv)
            * materialParams.color;
        material.baseColor = vec4(srgb_color.rgb * srgb_color.a, srgb_color.a);
    }
}
