material {
  name : "Blit",
  depthWrite: false,
  depthTest: false,
  parameters: [
    { type: sampler2d, name: sourceTexture }
  ],
  requires: [ uv0 ],
  constants : [
    {
        // Flag that indicates if P3 is supported on this platform.
        // Do not modify or update by yourself.
        name : enableColorConversion,
        type : bool,
        default : false
    }
  ],
  shadingModel: unlit,
  vertexDomain: device
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = texture(materialParams_sourceTexture, getUV0());
    }
}
