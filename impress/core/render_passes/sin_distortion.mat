material {
  name : "Sin Distortion",
  depthWrite: false,
  parameters: [
    { type: sampler2d, name: baseColor }
  ],
  requires: [ uv0 ],
  shadingModel: unlit,
  vertexDomain: device,
  featureLevel : 0
}

fragment {
  void material(inout MaterialInputs material) {
    prepareMaterial(material);

    vec2 uv = getUV0();
    uv += vec2(0.0, 0.025 * sin(uv.x * 30.0));

    vec3 rgb = texture2D(materialParams_baseColor, uv).rgb;

    material.baseColor = vec4(rgb, 1.0);
  }
}
