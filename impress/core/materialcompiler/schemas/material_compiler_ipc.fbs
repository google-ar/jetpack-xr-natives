namespace imp.schemas;

// Client->Service requests.

table CompileRequest {
  source_material: string (required);
}

table CloseRequest {}

union RequestType {
  CompileRequest,
  CloseRequest
}

table Request {
  request: RequestType;
}

root_type Request;

// Service->Client responses.

union ResponseType {
  CompileResponse,
  ErrorResponse
}

table Response {
  response: ResponseType;
}

table CompileResponse {
  compiled_material: [ubyte];
}

table ErrorResponse {
  message: string;
}

root_type Response;
