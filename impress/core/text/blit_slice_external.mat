material{
  name : "BlitSlice",
  parameters : [
    {type : {SAMPLER_EXTERNAL}, name : Slice}
  ],
  requires: [uv0],
  culling : none,
  depthWrite : false,
  blending : opaque,
  shadingModel : unlit,
  vertexDomain : device,
  flipUV : false,
  featureLevel : 0
} fragment {
  vec4 getSliceSample(highp vec2 uv) {
    return texture(materialParams_Slice, uv);
  }

  void material(inout MaterialInputs material) {
    prepareMaterial(material);

    highp vec2 uv = getUV0();
    vec4 slice_sample = getSliceSample(uv);
    material.baseColor = slice_sample;
  }
}
