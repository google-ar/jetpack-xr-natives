material{
  name : "TextWithStroke",
  parameters : [
    {type : {SAMPLER_EXTERNAL}, name : GlyphAtlas},
    {type : float4, name : TextColorFactor},
    {type : float4, name : StrokeColorFactor},
    {type : bool, name : ShouldSuperSample}
  ],
    requires
  : [uv0  // The texture coordinates of the glyph in the atlas. If the x coord
          // is negative, it is an outline stroke and should be drawn with the
          // StrokeColorFactor, otherwise it is a regular stroke and should
          // use the TextColorFactor. If the y coord is negative, then it is
          // an emoji and we should respect the original color from the atlas.
],
    culling : none,
    depthWrite : false,
    blending : transparent,
    shadingModel : unlit,
    flipUV : false,
    featureLevel : 0
  } fragment {
#include "text_material_common.glsl"

  void material(inout MaterialInputs material) {
    prepareMaterial(material);

    highp vec2 packed_uv = getUV0();
    vec4 glyph_sample = getGlyphSample(packed_uv);
    material.baseColor = getGlyphColor(packed_uv, glyph_sample);
  }
}
