material {
    requires : [color],
    name : debugDraw,
    blending : transparent,
    shadingModel : unlit,
    depthCulling : false,
    doubleSided : true,
    featureLevel : 0
}

vertex {
    float sRGB_to_linear(float color) {
      return color <= 0.04045 ? color / 12.92 : pow((color + 0.055) / 1.055, 2.4);
    }

    void materialVertex(inout MaterialVertexInputs material) {
        material.color.x = sRGB_to_linear(material.color.x);
        material.color.y = sRGB_to_linear(material.color.y);
        material.color.z = sRGB_to_linear(material.color.z);
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        material.baseColor = getColor();
        material.baseColor.xyz = inverseTonemap(material.baseColor.xyz);
    }
}
