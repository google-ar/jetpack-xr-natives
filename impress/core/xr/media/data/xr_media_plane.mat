// For video and images that use a traditional rectangular plane.

material {
    "name" : "XR Media Flat Plane",
    constants : [
        {
            name : enableColorConversion,
            type : bool,
            default : false
        }
    ],
    "parameters" : [
        {
          // The texture displaying the primary view of the media.
          "type" : {SAMPLER_EXTERNAL},
          "name" : mediaTexture
        },
        {
          // The texture displaying the secondary view of the media.
          // This is only used for interleaved stereo content.
          type : {SAMPLER_EXTERNAL},
          name : mediaAuxiliaryTexture
        },
        { type: int, name: stereoType },
        // Below are parameters for color conversions. They are unlikely to
        // change during the entire lifecycle of this material.
        // TODO: (broken link) - Convert these parameters to constants.
        {
            name: isVideo,
            type: bool,
            default: false
        },
        {
            type : float3x3,
            name : colorTransformMatrixSRGB,
        },
        {
            type : float3x3,
            name : colorTransformMatrixDisplayP3,
        },
        {
            name: transferFunction,
            type: int,
            default: 0
            // Expected values:
            // 1: Linear
            // 2: SRGB
            // 3: SMPTE170M
            // 10: Gamma22
            // 6: ST2084
            // 7: HLG
            // Source: (broken link)
        },
        {
            name : maxContentLightLevel,
            type : int,
            default : -1
        }
    ],
    "requires" : [
        "uv0"
    ],
    variables : [
        // Captures whether the material is being used in stereo mode or not at 'x'
        // If true, captures the index of the camera eye at 'y'
        // 0.0 is the left eye, 1.0 is the right eye.
        stereoData
    ],
    "shadingModel" : "unlit",
    "flipUV" : false
}

vertex {
  void materialVertex(inout MaterialVertexInputs material) {
#if defined(VARIANT_HAS_STEREO)
    material.stereoData.x = 1.0;
    material.stereoData.y = (getEyeIndex() % 2 < 1) ? 0.0 : 1.0;
#else
    material.stereoData.x = 0.0;
#endif
  }
}

fragment {
  #include "stereo.glsl"
  #include "dataspace_support.glsl"
  #include "color_conversion_helpers.glsl"

  void material(inout MaterialInputs material) {
    prepareMaterial(material);
    bool isLeftEye = (variable_stereoData.y < 1.0);

    // uv coordinates (and related variables) should always use high-precision
    // floats, or they may suffer from artifacts in sampling (e.g. shimmering
    // textures).
    highp vec2 uv = CalculateStereoUvs(getUV0(), materialParams.stereoType, isLeftEye);

    if (!gl_FrontFacing) {
        uv.x = 1.0 - uv.x;
    }
    uv.y = 1.0 - uv.y;

    vec4 textureColor = vec4(0.0);
    if (variable_stereoData.x > 0.0 && materialParams.stereoType == kInterleavedLeftPrimary) {
      textureColor = (variable_stereoData.y == 0.0) ?
        texture(materialParams_mediaTexture, uv).rgba :
        texture(materialParams_mediaAuxiliaryTexture, uv).rgba;
    } else if (variable_stereoData.x > 0.0 && materialParams.stereoType == kInterleavedRightPrimary) {
      textureColor = (variable_stereoData.y == 0.0) ?
        texture(materialParams_mediaAuxiliaryTexture, uv).rgba:
        texture(materialParams_mediaTexture, uv).rgba;
    } else {
      textureColor = texture(materialParams_mediaTexture, uv).rgba;
    }

    if (materialParams.isVideo) {
      // Some transfer functions will take a non-integer power on the input RGB, which will lead
      // to imaginary numbers (and thus NaN in the shader) if the input is negative.
      textureColor.rgb = max(textureColor.rgb, vec3(0.0));

      // If color conversion is enabled, use the display P3 color transform matrix.
      // Otherwise, use the sRGB color transform matrix.
      if (materialConstants_enableColorConversion) {
          highp float3 finalColor = convertColor(textureColor.rgb, materialParams.colorTransformMatrixDisplayP3);
          material.baseColor = vec4(finalColor, 1.0) * textureColor.a;
      } else {
          highp float3 finalColor = convertColor(textureColor.rgb, materialParams.colorTransformMatrixSRGB);
          material.baseColor = vec4(finalColor, 1.0) * textureColor.a;
      }
    } else {
      material.baseColor = vec4(sRGBToLinear(textureColor).rgb, 1.0) * textureColor.a;
      if (materialConstants_enableColorConversion) {
        material.baseColor.xyz = applyGlobalMaterialConversionMatrix(material.baseColor.xyz);
      }
    }
  }
}

