material {
    name : "Gizmo Visualizer Opaque",
    constants : [
        {
            // Flag that indicates if P3 is supported on this platform.
            // Do not modify or update by yourself.
            name : enableColorConversion,
            type : bool,
            default : false
        }
    ],
    parameters : [
        {
            type : float4,
            name : baseColor,
        },
        {
            type : float,
            name : scaleFactor,
        }
    ],
    shadingModel : unlit,
    blending : opaque,
    depthWrite : true,
    featureLevel: 0,
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // Scale the mesh relative to its distance from the camera.
        float3 origin = getWorldFromModelMatrix()[3].xyz;
        float dist = length(origin - getWorldCameraPosition());
        float3 worldPos = material.worldPosition.xyz;
        material.worldPosition.xyz = origin + (worldPos - origin) * dist * materialParams.scaleFactor;
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = materialParams.baseColor;
    }
}
