material {
    name : "Viewport Camera Orientation Axis",
    requires : [
        position,
        tangents
    ],
    parameters : [
        {
            type : float4,
            name : baseColor,
        },
        {
            type : float3,
            name : axisDirection,
        },
        {
            type : float,
            name : scaleFactor,
        }
    ],
    shadingModel : unlit,
    blending : transparent,
    depthWrite : true,
    featureLevel: 0,
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        float scale = materialParams.scaleFactor;
        // Retrieve the model scale from the length of the model-to-world matrix column,
        // which allows scaleFactor to be expressed in consistent model space units.
        float s = length(getWorldFromModelMatrix()[0].xyz);
        material.worldPosition.xyz += material.worldNormal * scale * s;
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        // Pre-multiply alpha for Filament's transparent blending model
        material.baseColor = vec4(
            materialParams.baseColor.rgb * materialParams.baseColor.a,
            materialParams.baseColor.a
        );
    }
}
