# proto-file: core/ncsb/node_data.proto
# proto-message: NodeData

name: "transform-widget"

groups: {
  groups: "EditorOverlay"
}

disabled: true
transform: {
  scale: {
    x: 0.02
    y: 0.02
    z: 0.02
  }
}

components: {
  [type.googleapis.com/imp.GltfState] {
    asset: "core/editor/widgets/transform_widget.glb"
  }
}

components: {
  [type.googleapis.com/imp.editor.TransformWidgetState] {
    translate: { name: "translate" }
    rotate: { name: "rotate" }
    scale: { name: "scale" }
  }
}

children: {
  name: "model_root"

  children: {
    name: "translate"
    children: {
      name: "translate_x"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectTranslateState] {
          axis: { x: 1 y: 0 z: 0 }
        }
      }
    }
    children: {
      name: "translate_y"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectTranslateState] {
          axis: { x: 0 y: 1 z: 0 }
        }
      }
    }
    children: {
      name: "translate_z"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectTranslateState] {
          axis: { x: 0 y: 0 z: 1 }
        }
      }
    }
    children: {
      name: "translate_xy"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectTranslateState] {
          axis: { x: 1 y: 1 z: 0 }
        }
      }
    }
    children: {
      name: "translate_xz"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectTranslateState] {
          axis: { x: 1 y: 0 z: 1 }
        }
      }
    }
    children: {
      name: "translate_yz"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectTranslateState] {
          axis: { x: 0 y: 1 z: 1 }
        }
      }
    }
  }

  children: {
    name: "rotate"
    disabled: true

    children: {
      name: "rotate_x"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectRotateState] {
          axis: { x: 1 y: 0 z: 0 }
        }
      }
    }
    children: {
      name: "rotate_y"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectRotateState] {
          axis: { x: 0 y: 1 z: 0 }
        }
      }
    }
    children: {
      name: "rotate_z"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectRotateState] {
          axis: { x: 0 y: 0 z: 1 }
        }
      }
    }
    children: {
      name: "rotate_camera"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectRotateState] {
          axis: { x: 1 y: 1 z: 1 }
          camera_facing: true
        }
      }
    }
  }

  children: {
    name: "scale"
    disabled: true

    children: {
      name: "scale_x"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectScaleState] {
          axis: { x: 1 y: 0 z: 0 }
        }
      }
    }
    children: {
      name: "scale_y"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectScaleState] {
          axis: { x: 0 y: 1 z: 0 }
        }
      }
    }
    children: {
      name: "scale_z"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectScaleState] {
          axis: { x: 0 y: 0 z: 1 }
        }
      }
    }
    children: {
      name: "scale_xy"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectScaleState] {
          axis: { x: 1 y: 1 z: 0 }
        }
      }
    }
    children: {
      name: "scale_xz"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectScaleState] {
          axis: { x: 1 y: 0 z: 1 }
        }
      }
    }
    children: {
      name: "scale_yz"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectScaleState] {
          axis: { x: 0 y: 1 z: 1 }
        }
      }
    }
    children: {
      name: "scale_xyz"
      components: {
        [type.googleapis.com/imp.editor.TransformWidgetAspectScaleState] {
          axis: { x: 1 y: 1 z: 1 }
        }
      }
    }
  }
}
