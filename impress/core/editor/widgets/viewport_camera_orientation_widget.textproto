# proto-file: core/ncsb/node_data.proto
# proto-message: NodeData

name: "viewport-camera-orientation-widget"

groups: {
  groups: "EditorOverlay"
}

disabled: true

components: {
  [type.googleapis.com/imp.GltfState] {
    asset: "core/editor/widgets/viewport_camera_orientation_widget.glb"
  }
}

components: {
  [type.googleapis.com/imp.editor.ViewportCameraOrientationWidgetState] {
    corner: TOP_RIGHT
    # Distance in pixels from the edge of the viewport.
    padding: 50
    # Size of the widget on the screen.
    radius: 4
    # Distance in meters from the camera in world space.
    depth: 0.5
    center: { gltf_node_name: "center" }
    x_negative: { gltf_node_name: "x_negative_cone" }
    x_positive: { gltf_node_name: "x_positive_cone" }
    y_negative: { gltf_node_name: "y_negative_cone" }
    y_positive: { gltf_node_name: "y_positive_cone" }
    z_negative: { gltf_node_name: "z_negative_cone" }
    z_positive: { gltf_node_name: "z_positive_cone" }
  }
}
