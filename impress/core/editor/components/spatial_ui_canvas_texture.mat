material {
  name : "SpatialUiCanvasTexture",
  constants : [
      {
          // Flag that indicates if P3 is supported on this platform.
          // Do not modify or update by yourself.
          name : enableColorConversion,
          type : bool,
          default : false
      }
  ],
  depthWrite: false,
  parameters: [
    { type: sampler2d, name: globalBaseColor },
    { type: float2, name: cornerUv },
    { type: float2, name: sizeUv }
  ],
  requires: [ uv0 ],
  culling : none,
  depthWrite : false,
  blending : transparent,
  shadingModel : unlit,
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        highp vec2 uv = getUV0();
        uv.x =  uv.x * materialParams.sizeUv.x + materialParams.cornerUv.x;
        uv.y =  1.0 - ((1.0 - uv.y) * materialParams.sizeUv.y + materialParams.cornerUv.y);
        uv = uvToRenderTargetUV(uv);
        vec4 color = texture(materialParams_globalBaseColor, uv);
        color.rgb = inverseTonemapSRGB(color.rgb);
        material.baseColor = color;
    }
}
