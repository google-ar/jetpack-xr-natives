material {
    "name" : "Video Material",
    "parameters" : [
        {
           // The texture displaying the frames of the video.
           "type" : {SAMPLER_EXTERNAL},
           "name" : "videoTexture"
        },
        {
           type      : sampler2d,
           format    : float,
           precision : high,
           name      : roughnessTexture
        },
        {
            "type" : float,
            "name" : "roughnessFactor"
        }
    ],
    "requires" : [
        "uv0"
    ],
    "shadingModel" : "lit",
    "flipUV" : false
}

fragment {
    float sRGB_to_linear(float color) {
      return color <= 0.04045 ? color / 12.92 : pow((color + 0.055) / 1.055, 2.4);
    }

    vec4 sRGB_to_linear(vec4 color) {
        return vec4(
            sRGB_to_linear(color.r),
            sRGB_to_linear(color.g),
            sRGB_to_linear(color.b),
            sRGB_to_linear(color.a));
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec2 uv = getUV0();

        if (!gl_FrontFacing) {
           uv.x = 1.0 - uv.x;
        }

        vec4 textureColor = texture(materialParams_videoTexture, uv).rgba;
        material.baseColor = vec4(inverseTonemapSRGB(textureColor.rgb), textureColor.a);
        material.emissive = sRGB_to_linear(textureColor);
        material.roughness = texture(materialParams_roughnessTexture, getUV0()).x * materialParams.roughnessFactor;
    }
}
