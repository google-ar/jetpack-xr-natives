material {
    "name" : "Camera",
    "defines" : [
        "baseColor"
    ],
    "parameters" : [
        {
           "type" : "{SAMPLER_EXTERNAL}",
           "name" : "cameraTexture"
        }
    ],
    "requires" : [
        "uv0"
    ],
    "vertexDomain" : "device",
    "depthWrite" : false,
    "shadingModel" : "unlit",
    "doubleSided" : true,
    featureLevel : 0
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);

        vec4 color = texture2D(materialParams_cameraTexture, getUV0());
        material.baseColor.rgb = inverseTonemapSRGB(color.rgb);
    }
}
