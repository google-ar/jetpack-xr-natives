material {
  name: "Screen Fader",
  blending: transparent,
  depthWrite: false,
  parameters: [
    {
      type: float3,
      name: color,
    },
    {
      type: float,
      name: alpha,
    }
  ],
  requires: [ uv0 ],
  shadingModel: unlit,
  vertexDomain: device,
  featureLevel : 0
}

fragment {
  void material(inout MaterialInputs material) {
    prepareMaterial(material);

    material.baseColor = materialParams.alpha
      * vec4(inverseTonemap(materialParams.color), 1.0);
  }
}
