material {
  name : "Valid Receiver Material Test",
  depthWrite: false,
  parameters: [
    { type: sampler2d, name: shadowTexture },
    { type: mat4, name: projection }
  ],
  variables : [
        uv
  ],
  requires: [ uv0 ],
  blending: opaque,
  shadingModel: unlit,
}

vertex {
  void materialVertex(inout MaterialVertexInputs material) {
    float3 worldPosition =
      mulMat4x4Float3(getWorldFromModelMatrix(), getPosition().xyz).xyz;
    float4 clip_pos = mulMat4x4Float3(materialParams.projection, worldPosition);
    material.uv.xy = (clip_pos.xy / clip_pos.w + 1.0) * 0.5;
  }
}

fragment {
  void material(inout MaterialInputs material) {
    prepareMaterial(material);
    float2 uv = variable_uv.xy;
    if (uv.x >= 0.0f && uv.x <= 1.0f && uv.y >= 0.0f && uv.y <= 1.0f) {
      float shadow = 1.0 - texture(materialParams_shadowTexture, uv).r;
      float strong_shadow = shadow * shadow;
      vec3 shadow_final = vec3(strong_shadow);
      material.baseColor = vec4(shadow_final, 1.0);
    }
  }
}
