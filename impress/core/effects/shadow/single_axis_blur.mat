material {
  name : "Contact Shadow Single Axis Blur",
  depthWrite: false,
  parameters: [
    { type: sampler2d, name: renderTargetSampler },
    { type: float, name: sizeNormalized },
    { type: float2, name: blurAxis }
  ],
  requires: [ uv0 ],
  vertexDomain: device,
  blending: opaque,
  shadingModel: unlit,
}

fragment {
  #include "gaussian_kernel.glsl"

  void material(inout MaterialInputs material) {
    prepareMaterial(material);

    vec2 uv = uvToRenderTargetUV(getUV0());

    // Determine the uv step for each iteration of the blur based on the size
    // of the outline.
    int2 texture_size = textureSize(materialParams_renderTargetSampler, 0);
    float aspect_ratio = float(texture_size.y) / float(texture_size.x);
    float step = (materialParams.sizeNormalized / 16.0) * aspect_ratio;

    float result = 0.0;
    float[16] kernel = getGaussianKernel();

    // Apply blur along axis.
    for (int i=0; i < 16; i++) {
      result += kernel[i] *
        texture(materialParams_renderTargetSampler,
          uv + (materialParams.blurAxis * (float(i) - 8.0) * step)).r;
    }

    material.baseColor = vec4(result);
  }
}
