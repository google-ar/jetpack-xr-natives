material {
    name : "Projector White",
    parameters : [
        {
            type : mat4,
            precision : high,
            name : clipFromWorld
        }
    ],
    blending : opaque,
    shadingModel : unlit,
    vertexDomain : device
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        // When foveation is enabled on head-mounted displays, the camera view
        // matrix for each eye might be dynamically adjusted or rotated.
        // To prevent the virtual shadow map from shifting or rotating relative
        // to the receiver plane, we use our static projector camera matrix
        // instead. highp is required to work properly in split engine.
        highp mat4 m = materialParams.clipFromWorld *
            getUserWorldFromWorldMatrix() * getWorldFromModelMatrix();
        material.clipSpaceTransform = m;
    }
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor = vec4(1.0, 1.0, 1.0, 1.0);
    }
}
