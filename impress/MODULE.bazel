bazel_dep(name = "aspect_bazel_lib", version = "1.16.3")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "flatbuffers", version = "25.2.10")
bazel_dep(name = "glog", version = "0.5.0", repo_name = "com_google_glog")
bazel_dep(name = "googletest", version = "1.15.2", repo_name = "com_google_googletest")
bazel_dep(name = "jsoncpp", version = "1.9.6")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "re2", version = "2024-07-02")
bazel_dep(name = "rules_android", version = "0.6.0", repo_name = "build_bazel_rules_android")
bazel_dep(name = "rules_android_ndk", version = "0.1.2")
bazel_dep(name = "rules_apple", version = "3.16.0", repo_name = "build_bazel_rules_apple")
bazel_dep(name = "rules_foreign_cc", version = "0.13.0")
