bazel_dep(name = "zlib", version = "1.3.1.bcr.3")

# Bazel modules with patcher and/or overrides
bazel_dep(name = "abseil-cpp", version = "20240722.0", repo_name = "com_google_absl")
single_version_override(
    module_name = "abseil-cpp",
    patch_strip = 1,
    patches = ["//:bazel/patches/com_google_absl.patch"],
)

bazel_dep(name = "protobuf", version = "29.0", repo_name = "com_google_protobuf")
single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = ["//:bazel/patches/com_google_protobuf.patch"],
)

# Adding GRPC 1.71.0 (and not the latest one), because it depends on protobuf 29.0
# Later versions depends on newer versions and protobuf patches fail to apply.
bazel_dep(name = "grpc", version = "1.71.0", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "gflags", version = "2.2.2")
single_version_override(
    module_name = "gflags",
    patch_strip = 1,
    patches = ["//:bazel/patches/gflags.patch"],
)

bazel_dep(name = "rules_kotlin", version = "2.1.0")
single_version_override(
    module_name = "rules_kotlin",
    patch_strip = 1,
    patches = ["//:bazel/patches/rules_kotlin.patch"],
)

# TODO investigate upgrading to latest version (https://github.com/bazelbuild/rules_python/commit/e6a6a3aa0c6a7e051c7a3b7573befc5b710dc189 may be relevant)
bazel_dep(name = "rules_cc", version = "0.0.17")

# http_archive repos
non_module_repos = use_extension("//:non_module_dependencies.bzl", "non_module_repos")
use_repo(non_module_repos, "SDL2")
use_repo(non_module_repos, "basis_universal")
use_repo(non_module_repos, "boost_beast")
use_repo(non_module_repos, "civetweb")
use_repo(non_module_repos, "com_google_sandboxed_api")
use_repo(non_module_repos, "com_google_zetasql")
use_repo(non_module_repos, "dear_imgui")
use_repo(non_module_repos, "draco")
use_repo(non_module_repos, "glslang")
use_repo(non_module_repos, "hedron_compile_commands")
use_repo(non_module_repos, "implot")
use_repo(non_module_repos, "mediapipe")
use_repo(non_module_repos, "meshoptimizer")
use_repo(non_module_repos, "robin_map")
use_repo(non_module_repos, "smol_v")
use_repo(non_module_repos, "spirv_cross")
use_repo(non_module_repos, "spirv_tools")
use_repo(non_module_repos, "stblib")
use_repo(non_module_repos, "tinyfiledialogs")
use_repo(non_module_repos, "vulkan_memory_allocator")
use_repo(non_module_repos, "zip")
use_repo(non_module_repos, "zlib_imp")
use_repo(non_module_repos, "zstdlib")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "androidx.activity:activity-ktx:1.3.0-alpha03",
        "androidx.annotation:annotation:1.3.0-alpha01",
        "androidx.annotation:annotation-experimental:1.4.1",
        "androidx.concurrent:concurrent-futures:1.1.0",
        "androidx.constraintlayout:constraintlayout:2.2.0-alpha05",
        "androidx.core:core:1.6.0-beta02",
        "androidx.core:core-ktx:1.5.0-beta02",
        "androidx.fragment:fragment:1.1.0",
        "androidx.lifecycle:lifecycle-common:2.4.0-alpha01",
        "androidx.lifecycle:lifecycle-runtime-ktx:2.4.0-alpha01",
        "androidx.lifecycle:lifecycle-runtime:2.4.0-alpha01",
        "androidx.lifecycle:lifecycle-viewmodel-ktx:2.4.0-alpha01",
        "com.android.extensions.xr:extensions-xr:1.0",
        "com.android.extensions.xr:extensions-xr:1.1.0",
        "com.google.errorprone:error_prone_annotations:2.27.1",
        "com.google.flogger:flogger-system-backend:0.6",
        "com.google.flogger:flogger:0.6",
        "com.google.guava:guava:31.1-android",
        "com.google.guava:listenablefuture:1.0",
    ],
    fetch_sources = True,
    
    repositories = [
        "https://maven.google.com",
        "https://dl.google.com/dl/android/maven2",
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")

# Set up the Android NDK
android_ndk_repository_extension = use_extension("@rules_android_ndk//:extension.bzl", "android_ndk_repository_extension")
android_ndk_repository_extension.configure(api_level = 29)
use_repo(android_ndk_repository_extension, "androidndk")

register_toolchains("@androidndk//:all")

# Ignore root user error for presubmits.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    ignore_root_user_error = True,
    python_version = "3.11",
)

bazel_dep(name = "third_party")
local_path_override(
    module_name = "third_party",
    path = "../third_party",
)
